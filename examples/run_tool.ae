// A thin wrapper around any program on the machine: it forwards its own
// arguments, waits for the child, and reports the exit status with whatever the
// child printed (stdout and stderr share one stream, so the order is kept).
// Run it as: ae run examples/run_tool.ae -- git --version

fn main() {
    let argv = args();
    if len(argv) < 2 {
        print("usage: run_tool <program> [args...]");
        exit(2);
    }
    var command: vec[string] = vec[];
    for i in 2..len(argv) {
        push(command, argv[i]);
    }
    let result = run_command(argv[1], command);
    match result {
        CommandResult::Ok(finished) => {
            print("status " + to_string(finished.status));
            print(finished.output);
        }
        CommandResult::Err(reason) => {
            print("cannot run " + argv[1] + ": " + reason);
            exit(1);
        }
    }
}
