fn apply(value: i64) -> i64 {
    let double = |x: i64| -> i64 { return x * 2; };
    return double(value);
}

fn bump(pointer: *mut i64) -> i64 {
    unsafe {
        *pointer = 8;
        return 8;
    }
}

fn main() {
    var value = 3;
    let after = bump(&mut value as *mut i64);
    print(value);
    print(after);
    print(apply(20));
    var numbers = vec[1, 2];
    push(numbers, 3);
    print(len(numbers));
}
