// ADR-0236 rung 3: `&v[start..end]` builds a sub-slice over a window of a
// vector, an array or an existing slice parameter. The fat pointer keeps the
// element size and starts at the offset, so len/index/for read the window
// exactly; the bounds are i64 expressions and are checked at the call site.
struct Tagged { name: string, n: i64 }

fn sum(values: &[i64]) -> i64 {
    var total = 0;
    for x in values { total += x; }
    return total;
}

fn forward(values: &[i64]) -> i64 { return sum(values); }

// A slice parameter can itself be windowed (`&values[start..end]`) and the
// window forwarded to another slice parameter.
fn inner(values: &[i64]) -> i64 { return sum(&values[1..3]); }

fn inner_forward(values: &[i64]) -> i64 { return inner(&values[0..3]); }

fn words_total(words: &[string]) -> i64 {
    var total = 0;
    for w in words { total += len(w); }
    return total;
}

fn tag_total(items: &[Tagged]) -> i64 {
    var total = 0;
    for t in items { total += t.n; }
    return total;
}

fn rows_total(rows: &[vec]) -> i64 {
    var total = 0;
    for row in rows { total += len(row); }
    return total;
}

fn float_total(values: &[f64]) -> f64 {
    var total = 0.0;
    for x in values { total += x; }
    return total;
}

fn main() {
    var v = vec[10, 20, 30, 40];
    print(sum(&v[1..3]));
    print(forward(&v[0..2]));
    print(sum(&v[2..2]));
    let start = 1;
    print(sum(&v[start..len(v)]));
    let a = [1, 2, 3, 4];
    print(sum(&a[2..4]));
    let words = vec["alpha", "beta", "gamma"];
    print(words_total(&words[1..3]));
    let tags = vec[Tagged { name: "x", n: 4 }, Tagged { name: "y", n: 5 }];
    print(tag_total(&tags[1..2]));
    let rows = vec[vec[1, 2], vec[3], vec[4, 5]];
    print(rows_total(&rows[1..3]));
    let floats = vec[1.5, 2.5, 3.5];
    print(float_total(&floats[0..2]));
    print(inner(&v));
    print(inner_forward(&v));
}