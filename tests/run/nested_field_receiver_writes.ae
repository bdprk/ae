// P2.4: vector operations through a nested struct-field receiver
// (`a.b.c.cells`). The path is resolved field by field from the root binding;
// a `&mut` root writes through its pointer at every level.
struct C { cells: vec, words: vec[string] }

struct B { c: C }

struct A { b: B }

fn grow(a: &mut A) { push(a.b.c.cells, 3); }

fn main() {
    var a = A { b: B { c: C { cells: vec[7], words: vec["alpha"] } } };
    push(a.b.c.cells, 8);
    print(len(a.b.c.cells));
    print(a.b.c.cells[1]);
    a.b.c.cells[0] = 9;
    print(a.b.c.cells[0]);
    pop(a.b.c.cells);
    print(len(a.b.c.cells));
    sort(a.b.c.cells);
    print(a.b.c.cells[0]);

    push(a.b.c.words, "beta");
    a.b.c.words[0] = "zeta";
    print(a.b.c.words[0]);
    print(len(a.b.c.words));

    grow(&mut a);
    print(len(a.b.c.cells));
}