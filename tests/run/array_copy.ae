#[derive(Copy)]
struct Pair {
    a: i64,
    b: i64,
}

struct Counter {
    n: i64,
}

fn next(c: &mut Counter) -> i64 {
    c.n += 1;
    return 0;
}

fn middle(values: &[i64; 3]) -> i64 {
    let copy = values;
    return copy[1];
}

fn main() {
    // `let copy = array;` copies; writing the source leaves the copy alone.
    var source = [1, 2, 3];
    let copy = source;
    source[0] = 99;
    print(copy[0]);
    print(source[0]);
    // Whole-array assignment from another binding and from a literal.
    var target = [0, 0, 0];
    target = source;
    print(target[0]);
    target = [4, 5, 6];
    print(target[2]);
    // The literal is evaluated completely before the stores: a swap.
    var swap = [1, 2, 3];
    swap = [swap[2], swap[0], swap[1]];
    print(swap[0]);
    print(swap[1]);
    print(swap[2]);
    // Compound element stores, including an effectful index (evaluated once).
    var counts = [10, 20];
    counts[1] += 5;
    counts[0] *= 2;
    print(counts[0]);
    print(counts[1]);
    var c = Counter { n: 0 };
    counts[next(&mut c)] -= 1;
    print(counts[0]);
    print(c.n);
    // An array parameter copies into a local; f64 arrays copy too.
    let param = [7, 8, 9];
    print(middle(&param));
    var floats = [1.5, 2.5];
    floats = [3.5, 4.5];
    floats[0] += 0.5;
    let float_copy = floats;
    print(float_copy[0]);
    print(float_copy[1]);
    // Copy struct elements copy element-wise.
    let pairs = [Pair { a: 1, b: 2 }, Pair { a: 3, b: 4 }];
    let pair_copy = pairs;
    print(pair_copy[1].a);
}
