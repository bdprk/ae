// P4.4: the in-program test tally. Each check prints a stable `ok`/`FAIL`
// line and bumps a counter; the totals are asserted at the end.
use "../../std/std/test/test.ae";

fn main() {
    var t = tally_new();
    assert(tally_passed(&t) == 0);
    assert(tally_failed(&t) == 0);
    assert(tally_total(&t) == 0);

    tally_check(&mut t, "truth is true", true);
    tally_check(&mut t, "truth is false?", false);
    tally_check_i64(&mut t, "two plus two", 2 + 2, 4);
    tally_check_i64(&mut t, "wrong math", 1 + 1, 3);
    tally_check_str(&mut t, "greeting", "hello", "hello");
    tally_check_str(&mut t, "mismatch", "hi", "bye");

    assert(tally_passed(&t) == 3);
    assert(tally_failed(&t) == 3);
    assert(tally_total(&t) == 6);

    print("test tally ok");
}
