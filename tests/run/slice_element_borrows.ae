// ADR-0236 rung 2: a place borrow can name one element of a slice
// parameter (`&items[0]`, `&rows[0]`), addressed in place and passed to a
// `&Struct`/`&vec` parameter for the call's duration — the same shape the
// vector element borrow uses. The owner is a slice, so nothing moves.
struct Tag { name: string, n: i64 }

fn tag_n(t: &Tag) -> i64 { return t.n; }

fn row_len(v: &vec) -> i64 { return len(v); }

fn first_n(items: &[Tag]) -> i64 { return tag_n(&items[0]); }

fn last_n(items: &[Tag]) -> i64 { return tag_n(&items[len(items) - 1]); }

fn first_row_len(rows: &[vec]) -> i64 { return row_len(&rows[0]); }

fn main() {
    let tags = vec[Tag { name: "x", n: 7 }, Tag { name: "y", n: 9 }];
    print(first_n(&tags));
    print(last_n(&tags));
    let rows = vec[vec[1, 2, 3], vec[4]];
    print(first_row_len(&rows));
}