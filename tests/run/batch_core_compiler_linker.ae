use "../../std/compiler/ir_linker_script.ae";
use "../../std/compiler/ir_archive_ar.ae";
use "../../std/compiler/ir_def_exports.ae";
use "../../std/compiler/ir_lto_summary.ae";

fn main() {
    assert(region_end(make_memory_region(134217728, 524288, 5)) == 134742016);
    assert(region_can_allocate(make_memory_region(0, 524288, 5), 1024, 4096));
    assert(!region_can_allocate(make_memory_region(0, 524288, 5), 524000, 1000));
    assert(region_has_flag(make_memory_region(0, 1, 5), 4));
    assert(placement_align_vma(1001, 16) == 1008);
    assert(ar_is_symbol_table(make_ar_member(0, 1, 0, 128), 47));
    assert(ar_is_longnames_table(make_ar_member(0, 2, 0, 128), 47, 47));
    assert(!ar_is_symbol_table(make_ar_member(0, 1, 0, 128), 97));
    assert(!ar_is_longnames_table(make_ar_member(0, 2, 0, 128), 97, 98));
    assert(!region_can_allocate(make_memory_region(0, 100, 5), -1, 2));
    assert(!region_has_flag(make_memory_region(0, 1, 5), 0));
    assert(ar_padded_size(127) == 128);
    assert(def_has_explicit_ordinal(make_def_export(101, 1)));
    assert(!def_is_forwarded(make_def_export(101, 1)));
    assert(lto_should_import(make_func_lto_summary(42, 50, 3, true), 100));
    assert(!lto_should_import(make_func_lto_summary(42, 50, 3, true), 30));
    print("batch_core_compiler_linker_all_passed");
}
