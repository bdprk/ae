use "../../std/compiler/ir_opcode.ae";
use "../../std/compiler/basic_block.ae";
use "../../std/compiler/vreg.ae";
use "../../std/compiler/cfg_edge.ae";

fn main() {
    assert(!ir_opcode_is_jump(IrOpcode::OpNop));
    assert(!ir_opcode_is_jump(IrOpcode::OpAdd));
    assert(ir_opcode_is_jump(IrOpcode::OpJump(10)));
    assert(ir_opcode_is_jump(IrOpcode::OpJumpIfFalse(5)));

    assert(ir_opcode_is_terminator(IrOpcode::OpReturn));
    assert(ir_opcode_is_terminator(IrOpcode::OpJump(20)));
    assert(!ir_opcode_is_terminator(IrOpcode::OpAdd));
    assert(!ir_opcode_is_terminator(IrOpcode::OpJumpIfFalse(5))); // not unconditional terminator

    let bb0 = basic_block_new(0);
    assert(basic_block_id(bb0) == 0);
    let bb0_b = basic_block_new(0);
    assert(basic_block_instruction_count(bb0_b) == 0);
    let bb0_c = basic_block_new(0);
    assert(!basic_block_has_terminator(bb0_c));

    let bb1 = basic_block_add_instruction(basic_block_new(0), false);
    assert(basic_block_instruction_count(bb1) == 1);
    let bb2 = basic_block_add_instruction(basic_block_add_instruction(basic_block_new(0), false), true);
    assert(basic_block_instruction_count(bb2) == 2);
    let bb2_b = basic_block_add_instruction(basic_block_add_instruction(basic_block_new(0), false), true);
    assert(basic_block_has_terminator(bb2_b));

    // After terminator, additional instructions are ignored
    let bb2_sealed = basic_block_add_instruction(basic_block_add_instruction(basic_block_add_instruction(basic_block_new(0), false), true), false);
    assert(basic_block_instruction_count(bb2_sealed) == 2);

    let vp0 = vreg_pool_new();
    assert(vreg_pool_allocated_count(vp0) == 0);
    let vp1 = vreg_pool_alloc(vreg_pool_new());
    assert(vreg_pool_allocated_count(vp1) == 1);
    let vp2 = vreg_pool_alloc(vreg_pool_alloc(vreg_pool_new()));
    assert(vreg_pool_allocated_count(vp2) == 2);

    assert(edge_kind_id(EdgeKind::EdgeFallthrough) == 1);
    assert(edge_kind_id(EdgeKind::EdgeUnconditionalJump) == 4);
    assert(!edge_kind_is_conditional(EdgeKind::EdgeFallthrough));
    assert(!edge_kind_is_conditional(EdgeKind::EdgeUnconditionalJump));
    assert(edge_kind_is_conditional(EdgeKind::EdgeBranchTrue));
    assert(edge_kind_is_conditional(EdgeKind::EdgeBranchFalse));

    print("IR CFG VREG BASICBLOCK OPERATIONAL");
}
