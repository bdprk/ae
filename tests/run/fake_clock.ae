// ADR-0224 R2.2: the fake clock is ordinary ae source in std/test, not a
// compiler builtin. Output is pinned against the former builtin implementation
// (timers_clock.stdout); timers now take the current time as a plain value.
use "../../std/std/test/fake_clock.ae";
use "../../std/std/task/timer.ae";

fn main() {
    let clk = fake_clock_new();
    print(fake_clock_now(clk));

    // L1: equal deadlines
    let t1 = timer_new(fake_clock_now(clk), 50);
    let t2 = timer_new(fake_clock_now(clk), 50);
    let t3 = timer_new(fake_clock_now(clk), 100);
    print(timer_ready(&t1, fake_clock_now(clk)));
    print(timer_ready(&t2, fake_clock_now(clk)));

    // L2: cancel t3 before deadline
    print(timer_cancel(&t3, fake_clock_now(clk)));
    print(timer_cancel(&t3, fake_clock_now(clk)));

    print(fake_clock_advance(clk, 50));
    print(timer_ready(&t1, fake_clock_now(clk)));
    print(timer_ready(&t2, fake_clock_now(clk)));
    // Post-deadline cancel returns false
    print(timer_cancel(&t1, fake_clock_now(clk)));

    // Advance past t3's deadline: cancelled timer stays unready
    print(fake_clock_advance(clk, 60));
    print(timer_ready(&t3, fake_clock_now(clk)));

    // L3: task executor drives a timeout using a controlled clock + yield.
    // The copied clock value shares one timeline between the two tasks.
    let ex = exec_new();
    let deadline = timer_new(fake_clock_now(clk), 30);
    task_spawn(ex, || -> i64 {
        // The capture moves in (spawn forbids borrow captures); take a local
        // so the poll can pass a reference without borrowing the capture.
        let dl_timer = deadline;
        var polls = 0;
        while !timer_ready(&dl_timer, fake_clock_now(clk)) {
            polls = polls + 1;
            task_yield();
        }
        print(polls);
        print("timeout_fired");
        return 0;
    });
    task_spawn(ex, || -> i64 {
        let a1 = fake_clock_advance(clk, 15);
        task_yield();
        let a2 = fake_clock_advance(clk, 15);
        return a1 + a2;
    });
    print(exec_run(ex));
    print(fake_clock_now(clk));
}
