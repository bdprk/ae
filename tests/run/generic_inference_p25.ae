// P2.5.2: bare generic call-site type inference for &T, &mut T, &[T], &mut [T], and vec[T].

struct Point {
    x: i64,
    y: i64,
}

struct Tagged {
    label: string,
    score: i64,
}

fn read_x[T](p: &T) -> i64 {
    return p.x;
}

fn id_val[T](x: T) -> T {
    return x;
}

fn mut_read_x[T](p: &mut T, dx: i64) -> i64 {
    return p.x + dx;
}

fn borrow_len[T](v: &T) -> i64 {
    return len(v);
}

fn slice_len[T](s: &[T]) -> i64 {
    return len(s);
}

fn slice_first[T](s: &[T]) -> T {
    return s[0];
}

fn forward_slice_len[T](s: &[T]) -> i64 {
    return slice_len(s);
}

fn set_first[T](s: &mut [T], val: T) {
    s[0] = val;
}

fn vec_len[T](v: vec[T]) -> i64 {
    return len(v);
}

fn roundtrip_vec[T](v: vec[T]) -> vec[T] {
    return v;
}

fn pair_len[T, U](s: &[T], v: vec[U]) -> i64 {
    return len(s) + len(v);
}

fn slice_plus[T](s: &[T], extra: i64) -> i64 {
    return len(s) + extra;
}

fn main() {
    // &T and &mut T on structs (including inferred return type chaining)
    let pt = Point { x: 10, y: 20 };
    print(read_x(&pt));
    let q = id_val(Point { x: 11, y: 20 });
    print(q.x);

    var mp = Point { x: 3, y: 4 };
    print(mut_read_x(&mut mp, 7));

    var tag = Tagged { label: "ok", score: 5 };
    print(tag.score);

    // &T on vec, vec[string], and string
    let vi = vec[10, 20, 30];
    let vs = vec["alpha", "beta"];
    print(borrow_len(&vi));
    print(borrow_len(&vs));
    print(borrow_len("hello"));

    // &[T] on vec, array, sub-slice, and forwarded slice
    print(slice_len(&vi));
    print(slice_len(&vs));
    let fixed = [7, 8, 9, 10];
    print(slice_len(&fixed));
    print(slice_len(&vi[1..3]));
    print(forward_slice_len(&vi));
    print(slice_first(&vi));
    print(slice_first(&fixed));

    // &mut [T] on vec and mutable sub-slice window
    var mv = vec[1, 2, 3, 4];
    set_first(&mut mv, 99);
    print(mv[0]);
    set_first(&mut mv[2..4], 77);
    print(mv[2]);

    // vec[T] inference and vec[T] return type precompute
    print(vec_len(vec[10, 20]));
    print(vec_len(vec["a", "b", "c"]));
    let v2 = roundtrip_vec(vec[4, 5, 6]);
    print(len(v2));

    // Multiple type parameters and fixed parameter alongside inferred
    print(pair_len(&vi, vec["x", "y"]));
    print(slice_plus(&fixed, 5));
}
