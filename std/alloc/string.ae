// std/alloc/string.ae
pub struct String {
    len: i64,
    cap: i64,
}

impl String {
    pub fn new() -> String {
        return String { len: 0, cap: 0 };
    }

    pub fn len(&self) -> i64 {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    pub fn capacity(&self) -> i64 {
        return self.cap;
    }
}