// std/alloc/default.ae
// Core Reset & Default Trait Specification (M1.7)

pub trait Reset {
    fn reset(x: T) -> T;
}

impl Reset for i64 {
    fn reset(x: i64) -> i64 {
        return 0;
    }
}

impl Reset for bool {
    fn reset(x: bool) -> bool {
        return false;
    }
}

impl Reset for string {
    fn reset(x: string) -> string {
        return "";
    }
}