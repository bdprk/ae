// std/alloc/vec.ae
pub struct Vec[T] {
    len: i64,
    cap: i64,
}

impl[T] Vec[T] {
    pub fn new() -> Vec[T] {
        return Vec { len: 0, cap: 0 };
    }

    pub fn len(&self) -> i64 {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    pub fn capacity(&self) -> i64 {
        return self.cap;
    }
}