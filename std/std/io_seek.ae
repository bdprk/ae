// std/std/io_seek.ae
// Stream seek position offset calculation primitives for Tier 3 std.

pub enum SeekFrom {
    Start(i64),
    Current(i64),
    End(i64),
}

pub fn calculate_seek_offset(seek: SeekFrom, current_pos: i64, total_len: i64) -> i64 {
    var next_pos = 0;
    match seek {
        SeekFrom::Start(offset) => {
            next_pos = offset;
        }
        SeekFrom::Current(offset) => {
            next_pos = current_pos + offset;
        }
        SeekFrom::End(offset) => {
            next_pos = total_len + offset;
        }
    }
    if next_pos < 0 {
        return 0;
    }
    return next_pos;
}
