// std/std/csv.ae
// Pure-AE CSV (P4.4). The `std` blueprint lists `csv` beside `json`; this is the
// first cut a program needs to emit and read tabular text. Fields follow RFC
// 4180 conventions: a field is quoted when it holds a comma, a quote or a line
// break, an embedded quote is doubled, and a quoted field is read back the same
// way. `string` is a byte container (ADR-0244), so copying walks a whole UTF-8
// sequence at a time and never splits a character.

use "../core/utf8.ae";

// Whether this field must be quoted to survive a round trip.
fn csv_needs_quotes(text: &string) -> bool {
    let comma = contains(text, ",");
    let quote = contains(text, "\"");
    let newline = contains(text, "\n");
    let carriage = contains(text, "\r");
    return comma || quote || newline || carriage;
}

// One CSV field: copied as-is when it is simple, otherwise wrapped in quotes
// with every `"` doubled.
pub fn encode_field(text: &string) -> string {
    if !csv_needs_quotes(text) {
        return slice(text, 0, len(text));
    }
    let raw = bytes(text);
    let size = len(raw);
    var out = "\"";
    var at = 0;
    while at < size {
        let b = raw[at];
        if b == 34 {
            let grown = out + "\"\"";
            out = grown;
            at = at + 1;
        } else {
            var width = utf8_sequence_length(b);
            if width == 0 {
                width = 1;
            }
            if at + width > size {
                width = 1;
            }
            let piece = slice(text, at, at + width);
            let grown = out + piece;
            out = grown;
            at = at + width;
        }
    }
    return out + "\"";
}

// A comma-separated row from its fields.
pub fn encode_row(fields: &vec[string]) -> string {
    var out = "";
    var first = true;
    for field in fields {
        if first {
            first = false;
        } else {
            let comma = out + ",";
            out = comma;
        }
        let grown = out + encode_field(field);
        out = grown;
    }
    return out;
}

// Read one CSV line back into its fields. A `"` at the start of a field opens a
// quoted field; inside it a doubled `""` is a literal quote and the next single
// `"` closes it. Everything else is copied verbatim.
pub fn parse_row(line: &string) -> vec[string] {
    let raw = bytes(line);
    let size = len(raw);
    var fields: vec[string] = vec[];
    var current = "";
    var quoted = false;
    var at = 0;
    while at < size {
        let b = raw[at];
        if quoted {
            if b == 34 {
                if at + 1 < size && raw[at + 1] == 34 {
                    let grown = current + "\"";
                    current = grown;
                    at = at + 2;
                } else {
                    quoted = false;
                    at = at + 1;
                }
            } else {
                var width = utf8_sequence_length(b);
                if width == 0 {
                    width = 1;
                }
                if at + width > size {
                    width = 1;
                }
                let piece = slice(line, at, at + width);
                let grown = current + piece;
                current = grown;
                at = at + width;
            }
        } else if b == 34 && len(current) == 0 {
            quoted = true;
            at = at + 1;
        } else if b == 44 {
            push(fields, current);
            current = "";
            at = at + 1;
        } else {
            var width = utf8_sequence_length(b);
            if width == 0 {
                width = 1;
            }
            if at + width > size {
                width = 1;
            }
            let piece = slice(line, at, at + width);
            let grown = current + piece;
            current = grown;
            at = at + width;
        }
    }
    push(fields, current);
    return fields;
}
