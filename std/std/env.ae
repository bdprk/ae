// std/std/env.ae
// Pure-AE typed environment access (P4.4). The `env` builtin returns a
// `ReadResult` holding the raw value, so a caller has to unwrap and parse it
// every time. These helpers do that once: `env_i64`/`env_bool` read a variable
// and fall back to a default when it is missing or unparsable, and `env_or`
// returns the raw value or a default. The parsing is split out
// (`parse_env_i64`, `parse_env_bool`) so it can be tested on literal strings
// without depending on the host's environment.

// Parse a base-10 integer, or `fallback` when the text is not one.
pub fn parse_env_i64(raw: &string, fallback: i64) -> i64 {
    let parsed = parse_int(raw);
    match parsed {
        IntResult::Ok(n) => { return n; }
        IntResult::Err(reason) => { return fallback; }
    }
}

// A boolean spelling: `1`/`true`/`yes` (any case) is true, `0`/`false`/`no`
// (any case) is false, anything else (including empty) is `fallback`.
pub fn parse_env_bool(raw: &string, fallback: bool) -> bool {
    let text = trim(raw);
    if text == "1" || text == "true" || text == "TRUE" || text == "True" || text == "yes" || text == "YES" {
        return true;
    }
    if text == "0" || text == "false" || text == "FALSE" || text == "False" || text == "no" || text == "NO" || text == "No" {
        return false;
    }
    return fallback;
}

// The environment variable `name` as an integer, or `fallback`.
pub fn env_i64(name: &string, fallback: i64) -> i64 {
    let result = env(name);
    match result {
        ReadResult::Ok(text) => { return parse_env_i64(text, fallback); }
        ReadResult::Err(reason) => { return fallback; }
    }
}

// The environment variable `name` as a boolean, or `fallback`.
pub fn env_bool(name: &string, fallback: bool) -> bool {
    let result = env(name);
    match result {
        ReadResult::Ok(text) => { return parse_env_bool(text, fallback); }
        ReadResult::Err(reason) => { return fallback; }
    }
}

// The environment variable `name` as an owned string, or a copy of `fallback`.
pub fn env_or(name: &string, fallback: &string) -> string {
    let result = env(name);
    match result {
        ReadResult::Ok(text) => { return slice(text, 0, len(text)); }
        ReadResult::Err(reason) => { return slice(fallback, 0, len(fallback)); }
    }
}
