// std/std/exit_code.ae
// Process termination exit status classification primitives for Tier 3 std.

pub enum ExitStatus {
    Success,
    GeneralFailure,
    InvalidUsage,
    NotFound,
    SignalKilled(i64),
}

pub fn exit_status_code(s: ExitStatus) -> i64 {
    var code = 0;
    match s {
        ExitStatus::Success => { code = 0; }
        ExitStatus::GeneralFailure => { code = 1; }
        ExitStatus::InvalidUsage => { code = 2; }
        ExitStatus::NotFound => { code = 127; }
        ExitStatus::SignalKilled(sig) => { code = 128 + sig; }
    }
    return code;
}

pub fn exit_status_is_success(s: ExitStatus) -> bool {
    var r = false;
    match s {
        ExitStatus::Success => { r = true; }
        ExitStatus::GeneralFailure => {}
        ExitStatus::InvalidUsage => {}
        ExitStatus::NotFound => {}
        ExitStatus::SignalKilled(sig) => {}
    }
    return r;
}
