// std/std/json.ae
// Pure-AE JSON writer (P4.4). The runtime only reads JSON today (json_get and
// its typed siblings); this module is the other half a caller needs to emit a
// document. It composes: encode each scalar with its own encoder, assemble
// arrays and objects out of the encoded pieces, and the result is a string a
// file or socket can carry.
//
// `string` is a byte container (ADR-0244), so encoding walks the raw bytes:
// the ASCII characters JSON must escape (`"`, `\`, the control bytes) are all
// single-byte, and every other byte is copied together with the whole UTF-8
// sequence it starts so a multibyte character is never split.

use "../core/utf8.ae";

// Two lower-case hex digits for a byte value in 0..255, used by the `\u00XX`
// escape for control characters without a short form.
fn hex2(value: i64) -> string {
    let digits = "0123456789abcdef";
    let hi = (value >> 4) & 15;
    let lo = value & 15;
    return slice(digits, hi, hi + 1) + slice(digits, lo, lo + 1);
}

// A JSON string: surrounding double quotes, with `"`, `\`, and the control
// characters escaped. Multibyte UTF-8 is copied through unchanged (JSON allows
// raw UTF-8). A byte that is not a valid UTF-8 lead is copied on its own so an
// invalid buffer still round-trips instead of trapping.
pub fn encode_string(text: &string) -> string {
    let raw = bytes(text);
    let size = len(raw);
    var out = "";
    var at = 0;
    while at < size {
        let b = raw[at];
        if b == 34 {
            // '"' -> \"
            let grown = out + "\\\"";
            out = grown;
            at = at + 1;
        } else if b == 92 {
            // '\\' -> \\
            let grown = out + "\\\\";
            out = grown;
            at = at + 1;
        } else if b == 8 {
            // backspace
            let grown = out + "\\b";
            out = grown;
            at = at + 1;
        } else if b == 12 {
            // form feed
            let grown = out + "\\f";
            out = grown;
            at = at + 1;
        } else if b == 10 {
            // newline
            let grown = out + "\\n";
            out = grown;
            at = at + 1;
        } else if b == 13 {
            // carriage return
            let grown = out + "\\r";
            out = grown;
            at = at + 1;
        } else if b == 9 {
            // tab
            let grown = out + "\\t";
            out = grown;
            at = at + 1;
        } else if b < 32 {
            // Any other control character has only the \u00XX spelling.
            let grown = out + "\\u00" + hex2(b);
            out = grown;
            at = at + 1;
        } else {
            // Copy the whole UTF-8 sequence this byte starts.
            var width = utf8_sequence_length(b);
            if width == 0 {
                width = 1;
            }
            if at + width > size {
                width = 1;
            }
            let piece = slice(text, at, at + width);
            let grown = out + piece;
            out = grown;
            at = at + width;
        }
    }
    return "\"" + out + "\"";
}

pub fn encode_bool(value: bool) -> string {
    if value {
        return "true";
    }
    return "false";
}

pub fn encode_i64(value: i64) -> string {
    return to_string(value);
}

// A finite float renders with `to_string`; NaN and the infinities have no JSON
// number spelling, so they are written as `null` (the usual choice a JSON
// encoder makes rather than emitting invalid JSON).
pub fn encode_f64(value: f64) -> string {
    if value != value {
        return "null";
    }
    let text = to_string(value);
    if contains(text, "inf") || contains(text, "Inf") || contains(text, "nan") || contains(text, "NaN") {
        return "null";
    }
    return text;
}

pub fn encode_null() -> string {
    return "null";
}

// `[ item, item, ... ]` from already-encoded element strings. Each element is
// copied in, so a borrowed vector of encoded pieces works.
pub fn encode_array(items: &vec[string]) -> string {
    var out = "[";
    var first = true;
    for item in items {
        if first {
            first = false;
        } else {
            let comma = out + ",";
            out = comma;
        }
        let grown = out + slice(item, 0, len(item));
        out = grown;
    }
    return out + "]";
}

// `"key": value` from an encoded key text (without quotes) and an already
// encoded value string. The key is quoted and escaped here; the value is
// inserted verbatim, so a caller passes `encode_i64(..)`, `encode_string(..)`
// or a nested `encode_object(..)`.
pub fn encode_field(key: &string, encoded_value: &string) -> string {
    return encode_string(key) + ":" + slice(encoded_value, 0, len(encoded_value));
}

// `{ member, member, ... }` from already-encoded member strings (each one a
// `"key":value` pair produced by `encode_field`).
pub fn encode_object(members: &vec[string]) -> string {
    var out = "{";
    var first = true;
    for member in members {
        if first {
            first = false;
        } else {
            let comma = out + ",";
            out = comma;
        }
        let grown = out + slice(member, 0, len(member));
        out = grown;
    }
    return out + "}";
}

// An array of integers encoded straight from a numeric vector — the common
// "list of ids/counts" payload, without first building a string vector.
pub fn encode_i64_array(values: &vec) -> string {
    var out = "[";
    var first = true;
    for value in values {
        if first {
            first = false;
        } else {
            let comma = out + ",";
            out = comma;
        }
        let grown = out + encode_i64(value);
        out = grown;
    }
    return out + "]";
}

// An array of floats, with the same non-finite rule as `encode_f64` (NaN and
// the infinities become `null`).
pub fn encode_f64_array(values: &vec[f64]) -> string {
    var out = "[";
    var first = true;
    for value in values {
        if first {
            first = false;
        } else {
            let comma = out + ",";
            out = comma;
        }
        let grown = out + encode_f64(value);
        out = grown;
    }
    return out + "]";
}

// ---------------------------------------------------------------------------
// Reading: a structural validator for the writer above. It answers "does this
// text hold exactly one well-formed JSON value?" without building a value tree,
// so a consumer can refuse a bad document (a malformed log line, a truncated
// payload) before handing it to `json_get`. Recursive descent over the raw
// bytes; every scanner returns the index just past what it consumed, or -1.
// ---------------------------------------------------------------------------

fn json_digit(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn json_hex(b: i64) -> bool {
    let lower = b >= 97 && b <= 102;
    let upper = b >= 65 && b <= 70;
    return json_digit(b) || lower || upper;
}

fn json_ws(b: i64) -> bool {
    // space, tab, line feed, carriage return
    return b == 32 || b == 9 || b == 10 || b == 13;
}

// Advance past insignificant whitespace; never runs past `size`.
fn json_skip_ws(raw: &vec, at: i64, size: i64) -> i64 {
    var i = at;
    while i < size && json_ws(raw[i]) {
        i = i + 1;
    }
    return i;
}

// A string literal starting at the opening quote (`at`). Handles the JSON
// escapes and the `\uXXXX` form; rejects a raw control byte and an
// unterminated or malformed escape.
fn json_scan_string(raw: &vec, at: i64, size: i64) -> i64 {
    var i = at + 1;
    while i < size {
        let b = raw[i];
        if b == 34 {
            return i + 1;
        }
        if b == 92 {
            i = i + 1;
            if i >= size {
                return -1;
            }
            let esc = raw[i];
            if esc == 34 || esc == 92 || esc == 47 || esc == 98 || esc == 102 || esc == 110 || esc == 114 || esc == 116 {
                i = i + 1;
            } else if esc == 117 {
                // \uXXXX: four hex digits follow.
                if i + 4 >= size {
                    return -1;
                }
                let h1 = json_hex(raw[i + 1]);
                let h2 = json_hex(raw[i + 2]);
                let h3 = json_hex(raw[i + 3]);
                let h4 = json_hex(raw[i + 4]);
                if !(h1 && h2 && h3 && h4) {
                    return -1;
                }
                i = i + 5;
            } else {
                return -1;
            }
        } else if b < 32 {
            return -1;
        } else {
            i = i + 1;
        }
    }
    return -1;
}

// A number: optional minus, an integer part with no leading zero, an optional
// fraction, an optional exponent.
fn json_scan_number(raw: &vec, at: i64, size: i64) -> i64 {
    var i = at;
    if i < size && raw[i] == 45 {
        i = i + 1;
    }
    if i >= size {
        return -1;
    }
    if raw[i] == 48 {
        i = i + 1;
    } else if json_digit(raw[i]) {
        i = i + 1;
        while i < size && json_digit(raw[i]) {
            i = i + 1;
        }
    } else {
        return -1;
    }
    if i < size && raw[i] == 46 {
        i = i + 1;
        if i >= size || !json_digit(raw[i]) {
            return -1;
        }
        while i < size && json_digit(raw[i]) {
            i = i + 1;
        }
    }
    if i < size && (raw[i] == 101 || raw[i] == 69) {
        i = i + 1;
        if i < size && (raw[i] == 43 || raw[i] == 45) {
            i = i + 1;
        }
        if i >= size || !json_digit(raw[i]) {
            return -1;
        }
        while i < size && json_digit(raw[i]) {
            i = i + 1;
        }
    }
    return i;
}

// Match one of the bare literals at `at`.
fn json_scan_word(raw: &vec, at: i64, size: i64, word: &vec) -> i64 {
    let wsize = len(word);
    if at + wsize > size {
        return -1;
    }
    var k = 0;
    while k < wsize {
        if raw[at + k] != word[k] {
            return -1;
        }
        k = k + 1;
    }
    return at + wsize;
}

fn json_scan_array(raw: &vec, at: i64, size: i64) -> i64 {
    var i = json_skip_ws(raw, at + 1, size);
    if i < size && raw[i] == 93 {
        return i + 1;
    }
    while true {
        i = json_scan_value(raw, i, size);
        if i < 0 {
            return -1;
        }
        i = json_skip_ws(raw, i, size);
        if i >= size {
            return -1;
        }
        if raw[i] == 44 {
            i = json_skip_ws(raw, i + 1, size);
        } else if raw[i] == 93 {
            return i + 1;
        } else {
            return -1;
        }
    }
    return -1;
}

fn json_scan_object(raw: &vec, at: i64, size: i64) -> i64 {
    var i = json_skip_ws(raw, at + 1, size);
    if i < size && raw[i] == 125 {
        return i + 1;
    }
    while true {
        if i >= size || raw[i] != 34 {
            return -1;
        }
        i = json_scan_string(raw, i, size);
        if i < 0 {
            return -1;
        }
        i = json_skip_ws(raw, i, size);
        if i >= size || raw[i] != 58 {
            return -1;
        }
        i = json_skip_ws(raw, i + 1, size);
        i = json_scan_value(raw, i, size);
        if i < 0 {
            return -1;
        }
        i = json_skip_ws(raw, i, size);
        if i >= size {
            return -1;
        }
        if raw[i] == 44 {
            i = json_skip_ws(raw, i + 1, size);
        } else if raw[i] == 125 {
            return i + 1;
        } else {
            return -1;
        }
    }
    return -1;
}

fn json_scan_value(raw: &vec, at: i64, size: i64) -> i64 {
    if at >= size {
        return -1;
    }
    let b = raw[at];
    if b == 34 {
        return json_scan_string(raw, at, size);
    }
    if b == 91 {
        return json_scan_array(raw, at, size);
    }
    if b == 123 {
        return json_scan_object(raw, at, size);
    }
    if b == 45 || json_digit(b) {
        return json_scan_number(raw, at, size);
    }
    if b == 116 {
        let word = bytes("true");
        return json_scan_word(raw, at, size, &word);
    }
    if b == 102 {
        let word = bytes("false");
        return json_scan_word(raw, at, size, &word);
    }
    if b == 110 {
        let word = bytes("null");
        return json_scan_word(raw, at, size, &word);
    }
    return -1;
}

// True when `doc` holds exactly one well-formed JSON value (surrounding
// whitespace allowed, nothing else).
pub fn json_valid(doc: &string) -> bool {
    let raw = bytes(doc);
    let size = len(raw);
    let start = json_skip_ws(&raw, 0, size);
    if start >= size {
        return false;
    }
    let end = json_scan_value(&raw, start, size);
    if end < 0 {
        return false;
    }
    return json_skip_ws(&raw, end, size) == size;
}
