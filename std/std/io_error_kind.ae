// std/std/io_error_kind.ae
// Standardized I/O error category classification primitives for Tier 3 std.

pub enum IoErrorKind {
    NotFound,
    PermissionDenied,
    ConnectionRefused,
    ConnectionReset,
    TimedOut,
    UnexpectedEof,
    Interrupted,
    Other,
}

pub fn io_error_kind_code(k: IoErrorKind) -> i64 {
    var code = 0;
    match k {
        IoErrorKind::NotFound => { code = 1; }
        IoErrorKind::PermissionDenied => { code = 2; }
        IoErrorKind::ConnectionRefused => { code = 3; }
        IoErrorKind::ConnectionReset => { code = 4; }
        IoErrorKind::TimedOut => { code = 5; }
        IoErrorKind::UnexpectedEof => { code = 6; }
        IoErrorKind::Interrupted => { code = 7; }
        IoErrorKind::Other => { code = 8; }
    }
    return code;
}

pub fn io_error_is_recoverable(k: IoErrorKind) -> bool {
    var r = false;
    match k {
        IoErrorKind::NotFound => {}
        IoErrorKind::PermissionDenied => {}
        IoErrorKind::ConnectionRefused => {}
        IoErrorKind::ConnectionReset => {}
        IoErrorKind::TimedOut => { r = true; }
        IoErrorKind::UnexpectedEof => {}
        IoErrorKind::Interrupted => { r = true; }
        IoErrorKind::Other => {}
    }
    return r;
}
