// std/std/io/reader.ae
// Scripted chunked byte reader over an in-memory string (ADR-0221, ADR-0224 R2.3).
// This replaces the former `reader_new` / `reader_read` / `reader_read_line` /
// `reader_eof` compiler builtins: the reader is an ordinary value whose state
// advances through explicit calls, so tests stay deterministic on every
// backend. Real file/network readers belong in std/io and std/net over the
// hosted primitives.

// A reader over one in-memory byte string: `src` is the whole payload,
// `chunk` caps how many bytes one refill or read may move, and `buf` holds a
// read_line refill window (bounded by `bcap`).
pub struct ByteReader {
    src: string,
    src_pos: i64,
    chunk: i64,
    buf: string,
    buf_pos: i64,
    bcap: i64,
}

pub fn reader_new(src: string, chunk_size: i64, buf_cap: i64) -> ByteReader {
    var chunk = chunk_size;
    if chunk < 1 { chunk = 1; }
    var bcap = buf_cap;
    if bcap < 1 { bcap = 1; }
    return ByteReader { src: src, src_pos: 0, chunk: chunk, buf: "", buf_pos: 0, bcap: bcap };
}

pub fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a; }
    return b;
}

// Read up to max_bytes, but never more than one chunk: chunked delivery is
// the scripted behaviour the buffered-reader tests rely on.
pub fn reader_read(r: &mut ByteReader, max_bytes: i64) -> string {
    if max_bytes <= 0 { return ""; }
    if r.buf_pos < len(r.buf) {
        let take = min_i64(len(r.buf) - r.buf_pos, min_i64(max_bytes, r.chunk));
        let out = "" + slice(r.buf, r.buf_pos, r.buf_pos + take);
        r.buf_pos = r.buf_pos + take;
        return out;
    }
    let rem = len(r.src) - r.src_pos;
    if rem <= 0 { return ""; }
    let take = min_i64(rem, min_i64(max_bytes, r.chunk));
    let out = "" + slice(r.src, r.src_pos, r.src_pos + take);
    r.src_pos = r.src_pos + take;
    return out;
}

// Read through the next newline (excluded) into one line. The buffer is
// refilled chunk-by-chunk until a newline arrives or the source is drained.
// One trailing carriage return is dropped, and EOF yields "".
pub fn reader_read_line(r: &mut ByteReader) -> string {
    var parts = strvec_new();
    while true {
        if r.buf_pos >= len(r.buf) {
            r.buf = "";
            r.buf_pos = 0;
            let rem = len(r.src) - r.src_pos;
            if rem <= 0 { break; }
            let n = min_i64(rem, min_i64(r.chunk, r.bcap));
            r.buf = "" + slice(r.src, r.src_pos, r.src_pos + n);
            r.src_pos = r.src_pos + n;
        }
        let window = "" + slice(r.buf, r.buf_pos, len(r.buf));
        let at = find(window, "\n");
        var found = false;
        match at {
            IntResult::Ok(i) => {
                push(parts, slice(window, 0, i));
                r.buf_pos = r.buf_pos + i + 1;
                found = true;
            }
            IntResult::Err(_) => {
                push(parts, window);
                r.buf_pos = len(r.buf);
            }
        }
        if found { break; }
    }
    let joined = join(parts, "");
    if ends_with(joined, "\r") {
        return "" + slice(joined, 0, len(joined) - 1);
    }
    return joined;
}

// True once the buffer window and the source are both drained.
pub fn reader_eof(r: &ByteReader) -> bool {
    return r.buf_pos >= len(r.buf) && r.src_pos >= len(r.src);
}
