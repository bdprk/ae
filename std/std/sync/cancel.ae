// std/std/sync/cancel.ae
// Cancellation tokens over the cell_* primitive family (ADR-0220, ADR-0224 R2.4).
// This replaces the former `cancel_new` / `cancel_trigger` / `cancel_complete` /
// `cancel_is_set` compiler builtins: the token is one shared atomic cell, so a
// copied handle observes the same state everywhere.
//
// State: 0 = active, 1 = cancelled, 2 = completed. The transitions match the
// old builtin exactly: trigger and complete each succeed only from the active
// state, and is_set reports only the cancelled state (1), never completed (2).

pub fn cancel_new() -> atomic {
    return cell_new(0);
}

pub fn cancel_trigger(c: atomic) -> bool {
    return cell_cas(c, 0, 1);
}

pub fn cancel_complete(c: atomic) -> bool {
    return cell_cas(c, 0, 2);
}

pub fn cancel_is_set(c: atomic) -> bool {
    return cell_load(c) == 1;
}
