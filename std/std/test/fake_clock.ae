// std/std/test/fake_clock.ae
// Deterministic manually-advanced monotonic clock used by tests (ADR-0224 R2.2).
// This replaces the former `clock_new` / `clock_now` / `clock_advance` compiler
// builtins: the clock is an ae module over the existing `cell_*` primitive
// family (copy-semantics handle to one shared i64 cell, ADR-0216 style), so a
// copied clock value shares the same timeline across tasks and threads.
//
// Monotonicity: negative deltas are ignored (the old builtin trapped with
// "clock_advance delta must be non-negative"; the language has no panic yet,
// and a no-op keeps the value strictly monotonic for test scaffolding).
// Real hosted time belongs in std/time over `now_ms`.

// A fake clock is a handle to one monotonic i64 timeline (epoch 0).
pub fn fake_clock_new() -> atomic {
    return cell_new(0);
}

pub fn fake_clock_now(c: atomic) -> i64 {
    return cell_load(c);
}

// Advance by delta and return the new timestamp; negative deltas are ignored.
// cell_add is fetch-add (it returns the previous value), so the post-add
// timestamp comes from a fresh load — matching the old builtin's semantics.
pub fn fake_clock_advance(c: atomic, delta: i64) -> i64 {
    var step = delta;
    if step < 0 { step = 0; }
    let added = cell_add(c, step);
    return cell_load(c);
}
