// std/compiler/ir_abi_varargs.ae
// Compiler machine ABI variadic argument saving area and register save bounds.

pub struct AbiVarargsArea {
    gp_offset: i64,      // Offset into GP save area (0..48 for 6 regs * 8)
    fp_offset: i64,      // Offset into FP save area (48..176 for 8 xmm * 16)
    overflow_arg_area: i64,
}

pub fn abi_varargs_new(gp_off: i64, fp_off: i64, overflow_off: i64) -> AbiVarargsArea {
    return AbiVarargsArea {
        gp_offset: gp_off,
        fp_offset: fp_off,
        overflow_arg_area: overflow_off,
    };
}

pub fn abi_varargs_has_more_gp(area: AbiVarargsArea) -> bool {
    // 6 GP registers * 8 bytes = 48 bytes
    return area.gp_offset < 48;
}

pub fn abi_varargs_advance_gp(area: AbiVarargsArea) -> AbiVarargsArea {
    let new_gp = area.gp_offset + 8;
    return AbiVarargsArea {
        gp_offset: new_gp,
        fp_offset: area.fp_offset,
        overflow_arg_area: area.overflow_arg_area,
    };
}
