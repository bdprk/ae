// std/compiler/scope_tree.ae
// Compiler lexical scope hierarchy and depth tracking primitives.

pub struct LexicalScope {
    scope_id: i64,
    parent_id: i64,
    depth: i64,
}

pub fn lexical_scope_root() -> LexicalScope {
    return LexicalScope {
        scope_id: 0,
        parent_id: -1,
        depth: 0,
    };
}

pub fn lexical_scope_new_child(parent: LexicalScope, new_id: i64) -> LexicalScope {
    return LexicalScope {
        scope_id: new_id,
        parent_id: parent.scope_id,
        depth: parent.depth + 1,
    };
}

pub fn lexical_scope_id(s: LexicalScope) -> i64 {
    return s.scope_id;
}

pub fn lexical_scope_depth(s: LexicalScope) -> i64 {
    return s.depth;
}

pub fn lexical_scope_is_root(s: LexicalScope) -> bool {
    return s.parent_id == -1;
}
