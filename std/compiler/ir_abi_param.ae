// std/compiler/ir_abi_param.ae
// Compiler machine ABI parameter register allocation and struct flattening layout.

pub struct AbiParamSlot {
    is_in_register: bool,
    reg_index: i64,      // 0..5 for x86_64 SysV (RDI, RSI, RDX, RCX, R8, R9)
    stack_offset: i64,   // Offset from caller stack frame if spilled
    size_bytes: i64,
}

pub fn abi_param_new(in_reg: bool, reg_idx: i64, offset: i64, size: i64) -> AbiParamSlot {
    return AbiParamSlot {
        is_in_register: in_reg,
        reg_index: reg_idx,
        stack_offset: offset,
        size_bytes: size,
    };
}

pub fn abi_param_is_reg(slot: AbiParamSlot) -> bool {
    return slot.is_in_register;
}

pub fn abi_param_reg_idx(slot: AbiParamSlot) -> i64 {
    return slot.reg_index;
}

pub fn abi_param_stack_offset(slot: AbiParamSlot) -> i64 {
    return slot.stack_offset;
}
