// std/compiler/ir_coalesce.ae
// Compiler register allocation coalescing candidate matcher (eliminates redundant moves).

pub struct CoalesceCandidate {
    vreg_a: i64,
    vreg_b: i64,
    interferes: bool,
    affinity_weight: i64,
}

pub fn coalesce_candidate_new(a: i64, b: i64, interfere: bool, weight: i64) -> CoalesceCandidate {
    return CoalesceCandidate {
        vreg_a: a,
        vreg_b: b,
        interferes: interfere,
        affinity_weight: weight,
    };
}

pub fn coalesce_can_merge(c: CoalesceCandidate) -> bool {
    // Cannot merge if live ranges interfere
    return !c.interferes;
}

pub fn coalesce_weight(c: CoalesceCandidate) -> i64 {
    return c.affinity_weight;
}
