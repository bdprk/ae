// std/compiler/span.ae
// Source span and line/column cursor positioning primitives.

pub struct TextPosition {
    line: i64,
    col: i64,
    offset: i64,
}

pub fn text_position_new(line: i64, col: i64, offset: i64) -> TextPosition {
    return TextPosition {
        line: line,
        col: col,
        offset: offset,
    };
}

pub fn text_position_line(pos: TextPosition) -> i64 {
    return pos.line;
}

pub fn text_position_col(pos: TextPosition) -> i64 {
    return pos.col;
}

pub fn text_position_offset(pos: TextPosition) -> i64 {
    return pos.offset;
}

pub struct SourceSpan {
    start_offset: i64,
    end_offset: i64,
    file_id: i64,
}

pub fn source_span_new(start: i64, end: i64, file: i64) -> SourceSpan {
    return SourceSpan {
        start_offset: start,
        end_offset: end,
        file_id: file,
    };
}

pub fn source_span_len(span: SourceSpan) -> i64 {
    if span.end_offset >= span.start_offset {
        return span.end_offset - span.start_offset;
    }
    return 0;
}

pub fn source_span_contains(span: SourceSpan, offset: i64) -> bool {
    return offset >= span.start_offset && offset < span.end_offset;
}
