// std/compiler/ir_dwarf_cie.ae
// Compiler DWARF Call Frame Information (CIE / FDE) common information entry descriptor.

pub struct DwarfCie {
    code_alignment_factor: i64,
    data_alignment_factor: i64,
    return_address_register: i64,
}

pub fn dwarf_cie_new(code_align: i64, data_align: i64, ret_reg: i64) -> DwarfCie {
    return DwarfCie {
        code_alignment_factor: code_align,
        data_alignment_factor: data_align,
        return_address_register: ret_reg,
    };
}

pub fn dwarf_cie_code_align(cie: DwarfCie) -> i64 {
    return cie.code_alignment_factor;
}

pub fn dwarf_cie_data_align(cie: DwarfCie) -> i64 {
    return cie.data_alignment_factor;
}

pub fn dwarf_cie_ret_reg(cie: DwarfCie) -> i64 {
    return cie.return_address_register;
}
