// std/compiler/ir_peep.ae
// Compiler peephole optimizer pattern matching primitives.

pub fn peep_is_redundant_mov(src: i64, dst: i64) -> bool {
    // MOV Rx, Rx is redundant and can be eliminated
    return src == dst;
}

pub fn peep_can_fuse_add_imm(imm1: i64, imm2: i64) -> bool {
    // Both are small immediates that can be combined without overflow
    return imm1 > -1000000 && imm1 < 1000000 && imm2 > -1000000 && imm2 < 1000000;
}

pub fn peep_fuse_add_imm(imm1: i64, imm2: i64) -> i64 {
    return imm1 + imm2;
}

pub fn peep_is_dead_store(store_reg: i64, next_kill_reg: i64) -> bool {
    return store_reg == next_kill_reg;
}
