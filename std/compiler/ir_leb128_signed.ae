// std/compiler/ir_leb128_signed.ae
// Zero-allocation signed LEB128 (SLEB128) encoding length and byte extraction primitives for DWARF/Wasm.

pub fn sleb128_encoded_len(val: i64) -> i64 {
    // 7 bits per byte + sign bit check
    if val >= -64 && val <= 63 {
        return 1;
    }
    if val >= -8192 && val <= 8191 {
        return 2;
    }
    if val >= -1048576 && val <= 1048575 {
        return 3;
    }
    if val >= -134217728 && val <= 134217727 {
        return 4;
    }
    return 5;
}

pub fn sleb128_extract_byte(val: i64, byte_idx: i64) -> i64 {
    // Convert 7-bit slice with sign handling
    var v = val;
    var i = 0;
    while i < byte_idx {
        if v < 0 {
            v = (v - 127) / 128; // arithmetic shift right simulation
        } else {
            v = v / 128;
        }
        i = i + 1;
    }
    var byte_val = v % 128;
    if byte_val < 0 {
        byte_val = byte_val + 128;
    }
    return byte_val;
}
