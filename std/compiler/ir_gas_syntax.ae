// std/compiler/ir_gas_syntax.ae
// Compiler AT&T (GNU Assembler) syntax prefix and operand direction descriptor.

pub struct GasSyntaxConfig {
    use_percent_prefix: bool,  // e.g. %rax vs rax
    use_dollar_imm: bool,      // e.g. $42 vs 42
    is_source_first: bool,     // AT&T: src, dst
}

pub fn gas_syntax_new(percent: bool, dollar: bool, src_first: bool) -> GasSyntaxConfig {
    return GasSyntaxConfig {
        use_percent_prefix: percent,
        use_dollar_imm: dollar,
        is_source_first: src_first,
    };
}

pub fn gas_syntax_is_att(c: GasSyntaxConfig) -> bool {
    return c.use_percent_prefix && c.use_dollar_imm && c.is_source_first;
}

pub fn gas_syntax_is_intel(c: GasSyntaxConfig) -> bool {
    return !c.use_percent_prefix && !c.use_dollar_imm && !c.is_source_first;
}
