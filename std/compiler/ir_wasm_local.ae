// std/compiler/ir_wasm_local.ae
// Compiler WebAssembly local variable entry and compressed run-length encoding (RLE).

pub struct WasmLocalRun {
    count: i64,
    val_type: i64, // 0x7E = i64, 0x7F = i32
}

pub fn wasm_local_run_new(count: i64, vtype: i64) -> WasmLocalRun {
    return WasmLocalRun {
        count: count,
        val_type: vtype,
    };
}

pub fn wasm_local_count(run: WasmLocalRun) -> i64 {
    return run.count;
}

pub fn wasm_local_type(run: WasmLocalRun) -> i64 {
    return run.val_type;
}
