// std/compiler/ir_dwarf_die.ae
// Compiler DWARF Debugging Information Entry (DIE) tag and attribute descriptor.

pub struct DwarfDie {
    tag: i64,          // 0x11=DW_TAG_compile_unit, 0x2e=DW_TAG_subprogram, 0x34=DW_TAG_variable
    has_children: bool,
    offset: i64,
}

pub fn dwarf_die_new(tag: i64, children: bool, offset: i64) -> DwarfDie {
    return DwarfDie {
        tag: tag,
        has_children: children,
        offset: offset,
    };
}

pub fn dwarf_die_is_subprogram(die: DwarfDie) -> bool {
    // 0x2e = DW_TAG_subprogram = 46
    return die.tag == 46;
}

pub fn dwarf_die_has_children(die: DwarfDie) -> bool {
    return die.has_children;
}

pub fn dwarf_die_offset(die: DwarfDie) -> i64 {
    return die.offset;
}
