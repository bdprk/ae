// std/compiler/ir_wasm_memory.ae
// Compiler WebAssembly linear memory limits and page size calculator.

pub struct WasmMemoryLimits {
    min_pages: i64,      // 64KiB per page
    max_pages: i64,      // -1 means unbounded
    has_max: bool,
}

pub fn wasm_mem_new(min_p: i64, max_p: i64, bounded: bool) -> WasmMemoryLimits {
    return WasmMemoryLimits {
        min_pages: min_p,
        max_pages: max_p,
        has_max: bounded,
    };
}

pub fn wasm_mem_min_bytes(m: WasmMemoryLimits) -> i64 {
    // 64 KiB = 65536 bytes
    return m.min_pages * 65536;
}

pub fn wasm_mem_has_max(m: WasmMemoryLimits) -> bool {
    return m.has_max;
}
