// std/compiler/ir_pe_export_dir.ae
// Compiler Windows PE export directory table descriptor and ordinal base calculator.

pub struct PeExportDirectory {
    ordinal_base: i64,
    number_of_functions: i64,
    number_of_names: i64,
    address_of_functions_rva: i64,
}

pub fn pe_export_dir_new(base: i64, funcs: i64, names: i64, funcs_rva: i64) -> PeExportDirectory {
    return PeExportDirectory {
        ordinal_base: base,
        number_of_functions: funcs,
        number_of_names: names,
        address_of_functions_rva: funcs_rva,
    };
}

pub fn pe_export_ordinal_index(dir: PeExportDirectory, ordinal: i64) -> i64 {
    // Zero-based index into AddressOfFunctions
    return ordinal - dir.ordinal_base;
}

pub fn pe_export_has_names(dir: PeExportDirectory) -> bool {
    return dir.number_of_names > 0;
}
