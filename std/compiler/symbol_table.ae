// std/compiler/symbol_table.ae
// Compiler symbol binding resolution status primitives.

pub enum SymbolBindingKind {
    BindingImmutableLet,
    BindingMutableVar,
    BindingFunctionParam,
    BindingTypeDefinition,
}

pub fn symbol_binding_can_reassign(k: SymbolBindingKind) -> bool {
    var r = false;
    match k {
        SymbolBindingKind::BindingImmutableLet => {}
        SymbolBindingKind::BindingMutableVar => { r = true; }
        SymbolBindingKind::BindingFunctionParam => {}
        SymbolBindingKind::BindingTypeDefinition => {}
    }
    return r;
}

pub fn symbol_binding_id(k: SymbolBindingKind) -> i64 {
    var id = 0;
    match k {
        SymbolBindingKind::BindingImmutableLet => { id = 1; }
        SymbolBindingKind::BindingMutableVar => { id = 2; }
        SymbolBindingKind::BindingFunctionParam => { id = 3; }
        SymbolBindingKind::BindingTypeDefinition => { id = 4; }
    }
    return id;
}
