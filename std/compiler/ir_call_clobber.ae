// std/compiler/ir_call_clobber.ae
// Compiler caller-saved vs callee-saved register clobber mask and spill necessity checker.

pub struct RegClobberMask {
    caller_saved_mask: i64, // Bitmask of registers clobbered across function calls
    callee_saved_mask: i64, // Bitmask of registers preserved by function
}

pub fn reg_clobber_mask_new(caller_mask: i64, callee_mask: i64) -> RegClobberMask {
    return RegClobberMask {
        caller_saved_mask: caller_mask,
        callee_saved_mask: callee_mask,
    };
}

pub fn reg_is_clobbered(m: RegClobberMask, phys_reg: i64) -> bool {
    var mask = m.caller_saved_mask;
    var i = 0;
    while i < phys_reg {
        mask = mask / 2;
        i = i + 1;
    }
    return (mask % 2) == 1;
}

pub fn reg_is_preserved(m: RegClobberMask, phys_reg: i64) -> bool {
    var mask = m.callee_saved_mask;
    var i = 0;
    while i < phys_reg {
        mask = mask / 2;
        i = i + 1;
    }
    return (mask % 2) == 1;
}
