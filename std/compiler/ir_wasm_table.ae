// std/compiler/ir_wasm_table.ae
// Compiler WebAssembly function table descriptor and indirect call element layout.

pub struct WasmTableDescriptor {
    elem_type: i64,      // 0x70 = funcref (externref)
    initial_size: i64,
    maximum_size: i64,
    has_max: bool,
}

pub fn wasm_table_new(elem: i64, initial: i64, max_sz: i64, bounded: bool) -> WasmTableDescriptor {
    return WasmTableDescriptor {
        elem_type: elem,
        initial_size: initial,
        maximum_size: max_sz,
        has_max: bounded,
    };
}

pub fn wasm_table_is_funcref(t: WasmTableDescriptor) -> bool {
    // 0x70 = 112 (funcref)
    return t.elem_type == 112;
}

pub fn wasm_table_initial(t: WasmTableDescriptor) -> i64 {
    return t.initial_size;
}

pub fn wasm_table_has_max(t: WasmTableDescriptor) -> bool {
    return t.has_max;
}
