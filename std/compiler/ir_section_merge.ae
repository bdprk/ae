// std/compiler/ir_section_merge.ae
// Laying input sections out inside an output section: where the next one starts,
// how many bytes of padding that costs, and what address a slot ends up at.
//
// Alignment is not required to be a power of two here. The container headers
// record a numeric alignment (ir_section), and rounding by division holds for
// any positive value, so nothing in this file assumes 2^n.

pub struct SectionCursor {
    offset: i64,    // Bytes already placed in the output section.
}

pub fn section_cursor_start() -> SectionCursor {
    return SectionCursor { offset: 0 };
}

/// Rounds `value` up to the next multiple of `alignment`.
pub fn align_up(value: i64, alignment: i64) -> i64 {
    // Zero and one mean "no constraint", which is how an input section that does
    // not care is recorded.
    if alignment <= 1 {
        return value;
    }
    // A negative offset is malformed input, not something to round: rounding it
    // up would move data into the previous section.
    if value < 0 {
        return value;
    }
    let rem = value % alignment;
    if rem == 0 {
        return value;
    }
    return value + (alignment - rem);
}

/// Padding bytes introduced by placing the next item at `alignment`.
pub fn merge_padding(offset: i64, alignment: i64) -> i64 {
    return align_up(offset, alignment) - offset;
}

/// Offset the next item will occupy, without advancing the cursor.
pub fn merge_slot_offset(cursor: SectionCursor, alignment: i64) -> i64 {
    return align_up(cursor.offset, alignment);
}

/// Places one item and returns the cursor after it.
pub fn merge_place(cursor: SectionCursor, size_bytes: i64, alignment: i64) -> SectionCursor {
    let start = align_up(cursor.offset, alignment);
    // A negative size contributes no bytes; the alignment padding it asked for
    // still applies, so the cursor moves to the slot it reserved.
    if size_bytes < 0 {
        return SectionCursor { offset: start };
    }
    return SectionCursor { offset: start + size_bytes };
}

pub fn merge_total_bytes(cursor: SectionCursor) -> i64 {
    return cursor.offset;
}

/// Final address of a placed slot once the output section has a base address.
pub fn merge_address(base: i64, offset: i64) -> i64 {
    return base + offset;
}

/// Whether two input sections may share one output section. Section flags are
/// WRITE=1, ALLOC=2, EXECINSTR=4 (ir_section); code merged into a writable-only
/// output section would be rejected by the loader, so the executable bit and the
/// writable bit must agree.
pub fn merge_flags_compatible(existing: i64, incoming: i64) -> bool {
    let e_exec = (existing / 4) % 2;
    let i_exec = (incoming / 4) % 2;
    if e_exec != i_exec {
        return false;
    }
    return existing % 2 == incoming % 2;
}
