// std/compiler/ir_elf_symtab.ae
// Compiler ELF64 symbol table entry layout and binding/visibility encoder.

pub struct ElfSymEntry {
    name_str_offset: i64,
    info_binding: i64,   // 0=LOCAL, 1=GLOBAL, 2=WEAK
    info_type: i64,      // 0=NOTYPE, 1=OBJECT, 2=FUNC, 3=SECTION, 4=FILE
    section_index: i64,
    value_offset: i64,
    size_bytes: i64,
}

pub fn elf_sym_new(name_off: i64, binding: i64, s_type: i64, section: i64, value: i64, size: i64) -> ElfSymEntry {
    return ElfSymEntry {
        name_str_offset: name_off,
        info_binding: binding,
        info_type: s_type,
        section_index: section,
        value_offset: value,
        size_bytes: size,
    };
}

pub fn elf_sym_is_function(sym: ElfSymEntry) -> bool {
    return sym.info_type == 2;
}

pub fn elf_sym_is_global(sym: ElfSymEntry) -> bool {
    return sym.info_binding == 1;
}

pub fn elf_sym_is_local(sym: ElfSymEntry) -> bool {
    return sym.info_binding == 0;
}

pub fn elf_sym_st_info(sym: ElfSymEntry) -> i64 {
    // (binding << 4) + (type & 0xf)
    return sym.info_binding * 16 + (sym.info_type % 16);
}
