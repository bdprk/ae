// std/compiler/ir_strtab.ae
// Zero-allocation string table offset calculator for object headers.

pub struct StrtabBuilder {
    current_offset: i64,
    entry_count: i64,
}

pub fn strtab_builder_new() -> StrtabBuilder {
    // Offset starts at 1 because index 0 is always null byte in ELF
    return StrtabBuilder {
        current_offset: 1,
        entry_count: 0,
    };
}

pub fn strtab_builder_offset(b: StrtabBuilder) -> i64 {
    return b.current_offset;
}

pub fn strtab_builder_count(b: StrtabBuilder) -> i64 {
    return b.entry_count;
}

pub fn strtab_builder_append(b: StrtabBuilder, str_len: i64) -> StrtabBuilder {
    // string bytes + 1 null terminator
    let advance = str_len + 1;
    return StrtabBuilder {
        current_offset: b.current_offset + advance,
        entry_count: b.entry_count + 1,
    };
}
