// std/compiler/ir_macho_header.ae
// Compiler macOS Mach-O 64-bit file header layout and magic/CPU type validator.

pub struct MachO64Header {
    is_valid_magic: bool, // 0xFEEDFACF for MH_MAGIC_64
    cpu_type: i64,        // 0x01000007 for CPU_TYPE_X86_64 or 0x0100000C for CPU_TYPE_ARM64
    file_type: i64,       // 1=MH_OBJECT, 2=MH_EXECUTE, 6=MH_DYLIB
    ncmds: i64,           // Number of load commands
    sizeofcmds: i64,      // Size of all load commands
}

pub fn macho64_header_new(cpu: i64, ftype: i64, ncmds: i64, sizeofcmds: i64) -> MachO64Header {
    return MachO64Header {
        is_valid_magic: true,
        cpu_type: cpu,
        file_type: ftype,
        ncmds: ncmds,
        sizeofcmds: sizeofcmds,
    };
}

pub fn macho64_is_object(h: MachO64Header) -> bool {
    return h.file_type == 1;
}

pub fn macho64_is_x86_64(h: MachO64Header) -> bool {
    return h.cpu_type == 16777223; // 0x01000007
}

pub fn macho64_is_arm64(h: MachO64Header) -> bool {
    return h.cpu_type == 16777228; // 0x0100000C
}
