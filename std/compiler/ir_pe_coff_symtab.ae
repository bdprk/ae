// std/compiler/ir_pe_coff_symtab.ae
// Compiler Windows PE/COFF symbol record and storage class classifier.

pub struct CoffSymbol {
    name_str_offset: i64,
    value: i64,
    section_number: i64, // 1-based, 0=IMAGE_SYM_UNDEFINED, -1=IMAGE_SYM_ABSOLUTE
    storage_class: i64,  // 2=IMAGE_SYM_CLASS_EXTERNAL, 3=IMAGE_SYM_CLASS_STATIC
    aux_symbols: i64,
}

pub fn coff_symbol_new(name_off: i64, val: i64, sect: i64, sclass: i64, aux: i64) -> CoffSymbol {
    return CoffSymbol {
        name_str_offset: name_off,
        value: val,
        section_number: sect,
        storage_class: sclass,
        aux_symbols: aux,
    };
}

pub fn coff_symbol_is_external(s: CoffSymbol) -> bool {
    return s.storage_class == 2;
}

pub fn coff_symbol_is_defined(s: CoffSymbol) -> bool {
    return s.section_number > 0;
}

pub fn coff_symbol_is_undefined(s: CoffSymbol) -> bool {
    return s.section_number == 0;
}
