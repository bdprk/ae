// std/compiler/cfg_edge.ae
// Compiler Control Flow Graph (CFG) branch edge classification primitives.

pub enum EdgeKind {
    EdgeFallthrough,
    EdgeBranchTrue,
    EdgeBranchFalse,
    EdgeUnconditionalJump,
}

pub fn edge_kind_id(k: EdgeKind) -> i64 {
    var id = 0;
    match k {
        EdgeKind::EdgeFallthrough => { id = 1; }
        EdgeKind::EdgeBranchTrue => { id = 2; }
        EdgeKind::EdgeBranchFalse => { id = 3; }
        EdgeKind::EdgeUnconditionalJump => { id = 4; }
    }
    return id;
}

pub fn edge_kind_is_conditional(k: EdgeKind) -> bool {
    var r = false;
    match k {
        EdgeKind::EdgeFallthrough => {}
        EdgeKind::EdgeBranchTrue => { r = true; }
        EdgeKind::EdgeBranchFalse => { r = true; }
        EdgeKind::EdgeUnconditionalJump => {}
    }
    return r;
}
