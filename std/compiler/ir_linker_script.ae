// std/compiler/ir_linker_script.ae
// Linker script memory region and section placement abstractions.
// Provides representations for MEMORY regions, origin/length constraints,
// section attributes (read, write, execute, alloc), and VMA/LMA mappings.

pub struct MemoryRegion {
    origin: i64,
    length: i64,
    flags: i64, // 1: Read, 2: Write, 4: Execute, 8: Alloc
}

pub struct SectionPlacement {
    section_id: i64,
    region_id: i64,
    align_bytes: i64,
    vma_offset: i64,
    is_load: bool,
}

pub fn make_memory_region(origin: i64, length: i64, flags: i64) -> MemoryRegion {
    return MemoryRegion {
        origin: origin,
        length: length,
        flags: flags,
    };
}

pub fn region_end(region: MemoryRegion) -> i64 {
    return region.origin + region.length;
}

pub fn region_can_allocate(region: MemoryRegion, current_offset: i64, size: i64) -> bool {
    return current_offset >= 0 && size >= 0 && current_offset <= region.length && size <= region.length - current_offset;
}

pub fn region_has_flag(region: MemoryRegion, flag: i64) -> bool {
    if flag <= 0 { return false; }
    return (region.flags / flag) % 2 != 0;
}

pub fn make_section_placement(sec_id: i64, reg_id: i64, align_bytes: i64, vma: i64, is_load: bool) -> SectionPlacement {
    return SectionPlacement {
        section_id: sec_id,
        region_id: reg_id,
        align_bytes: align_bytes,
        vma_offset: vma,
        is_load: is_load,
    };
}

pub fn placement_align_vma(vma: i64, align_bytes: i64) -> i64 {
    if align_bytes <= 1 {
        return vma;
    } else {
        let rem = vma % align_bytes;
        if rem == 0 {
            return vma;
        } else {
            return vma + (align_bytes - rem);
        }
    }
}
