// std/compiler/ir_call_conv.ae
// Standard System V / Windows x64 calling convention argument register assignment.

pub fn arg_register_index(arg_idx: i64) -> i64 {
    // Up to 6 arguments passed in registers: 0..5
    // Returns phys reg index 0..5, or -1 for stack spill
    if arg_idx >= 0 && arg_idx < 6 {
        return arg_idx;
    }
    return -1;
}

pub fn arg_is_passed_on_stack(arg_idx: i64) -> bool {
    return arg_idx >= 6;
}

pub fn arg_stack_offset(arg_idx: i64) -> i64 {
    if arg_idx < 6 {
        return 0;
    }
    // Starts after 6 register args (8 bytes each)
    return (arg_idx - 6) * 8 + 16;
}
