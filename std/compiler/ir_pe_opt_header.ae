// std/compiler/ir_pe_opt_header.ae
// Compiler Windows PE32+ (64-bit) optional header and subsystem characteristics descriptor.

pub struct PeOptHeader64 {
    magic: i64,                  // 0x20b = PE32+ (64-bit)
    address_of_entry_point: i64,
    image_base: i64,
    section_alignment: i64,      // Typically 4096 (0x1000)
    file_alignment: i64,         // Typically 512 (0x200)
    subsystem: i64,              // 2=WINDOWS_GUI, 3=WINDOWS_CUI (Console)
    dll_characteristics: i64,    // 0x0040=DYNAMIC_BASE (ASLR), 0x0100=NX_COMPAT (DEP)
}

pub fn pe_opt_header_new(entry: i64, base: i64, sect_align: i64, file_align: i64, sub: i64, dll_chars: i64) -> PeOptHeader64 {
    return PeOptHeader64 {
        magic: 523, // 0x20b
        address_of_entry_point: entry,
        image_base: base,
        section_alignment: sect_align,
        file_alignment: file_align,
        subsystem: sub,
        dll_characteristics: dll_chars,
    };
}

pub fn pe_is_pe32_plus(h: PeOptHeader64) -> bool {
    return h.magic == 523;
}

pub fn pe_is_console_subsystem(h: PeOptHeader64) -> bool {
    return h.subsystem == 3;
}

pub fn pe_has_aslr(h: PeOptHeader64) -> bool {
    // 0x0040 = 64
    let shifted = h.dll_characteristics / 64;
    return (shifted % 2) == 1;
}

pub fn pe_has_dep(h: PeOptHeader64) -> bool {
    // 0x0100 = 256
    let shifted = h.dll_characteristics / 256;
    return (shifted % 2) == 1;
}
