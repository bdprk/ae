// std/compiler/ir_query_key.ae
// Incremental compilation query identity (query-based cache keys).
// A query key is the triple (kind, target, input fingerprint). A cached result
// stays reusable only while all three agree; a moved input fingerprint makes
// the entry stale without reading or rewriting the cached payload.

pub fn query_kind_parse() -> i64 {
    return 1;
}

pub fn query_kind_resolve() -> i64 {
    return 2;
}

pub fn query_kind_typeck() -> i64 {
    return 3;
}

pub fn query_kind_mir() -> i64 {
    return 4;
}

pub fn query_kind_codegen() -> i64 {
    return 5;
}

pub fn query_kind_is_known(kind: i64) -> bool {
    return kind >= query_kind_parse() && kind <= query_kind_codegen();
}

pub struct QueryKey {
    kind: i64,
    target: i64,
    input_hash: i64,
}

pub fn make_query_key(kind: i64, target: i64, input_hash: i64) -> QueryKey {
    return QueryKey { kind: kind, target: target, input_hash: input_hash };
}

pub fn query_key_digest(key: QueryKey) -> i64 {
    // Fold the three components with the shared combiner constant so that a
    // change in any component reaches the digest. Intermediate products stay
    // below the i64 range and are reduced to a positive value.
    let k = 1000003;
    let h1 = (key.kind * k + key.target) % 2147483647;
    let h2 = (h1 * k + key.input_hash) % 2147483647;
    if h2 < 0 {
        return 0 - h2;
    }
    return h2;
}

pub fn query_key_matches(a: QueryKey, b: QueryKey) -> bool {
    return a.kind == b.kind && a.target == b.target && a.input_hash == b.input_hash;
}

pub fn query_key_stale(key: QueryKey, current_input_hash: i64) -> bool {
    if key.input_hash == current_input_hash {
        return false;
    }
    return true;
}

pub fn query_key_same_target(a: QueryKey, b: QueryKey) -> bool {
    // Two queries over the same target differ only by kind or input; this
    // distinguishes "same item, new input" from "different item".
    return a.kind == b.kind && a.target == b.target;
}

pub fn query_key_chain_digest(stage_count: i64, last_digest: i64) -> i64 {
    // Digest for a pipeline position: the number of upstream queries is folded
    // in so that inserting a stage cannot collide with the previous shape.
    let k = 1000003;
    let h = (stage_count * k + last_digest) % 2147483647;
    if h < 0 {
        return 0 - h;
    }
    return h;
}
