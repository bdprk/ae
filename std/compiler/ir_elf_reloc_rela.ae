// std/compiler/ir_elf_reloc_rela.ae
// Compiler ELF64 RELA explicit addend relocation entry encoder.

pub struct ElfRelaEntry {
    offset: i64,
    sym_index: i64,
    reloc_type: i64,    // e.g. 1=R_X86_64_64, 2=R_X86_64_PC32, 4=R_X86_64_PLT32, 9=R_X86_64_GOTPCREL
    addend: i64,
}

pub fn elf_rela_new(off: i64, sym_idx: i64, r_type: i64, add: i64) -> ElfRelaEntry {
    return ElfRelaEntry {
        offset: off,
        sym_index: sym_idx,
        reloc_type: r_type,
        addend: add,
    };
}

pub fn elf_rela_r_info_type(entry: ElfRelaEntry) -> i64 {
    return entry.reloc_type;
}

pub fn elf_rela_r_info_sym(entry: ElfRelaEntry) -> i64 {
    return entry.sym_index;
}

pub fn elf_rela_addend(entry: ElfRelaEntry) -> i64 {
    return entry.addend;
}
