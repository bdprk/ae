// std/compiler/ir_reg_alloc.ae
// Linear scan register allocation state tracker for ae backend.

pub struct RegAllocation {
    vreg_id: i64,
    phys_reg: i64, // -1 means spilled to stack
}

pub fn reg_allocation_new(vreg: i64, phys: i64) -> RegAllocation {
    return RegAllocation {
        vreg_id: vreg,
        phys_reg: phys,
    };
}

pub fn reg_allocation_vreg(ra: RegAllocation) -> i64 {
    return ra.vreg_id;
}

pub fn reg_allocation_phys(ra: RegAllocation) -> i64 {
    return ra.phys_reg;
}

pub fn reg_allocation_is_spilled(ra: RegAllocation) -> bool {
    return ra.phys_reg < 0;
}
