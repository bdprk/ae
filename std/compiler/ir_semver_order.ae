// std/compiler/ir_semver_order.ae
// Total order over semantic versions, including the prerelease rule SemVer
// spells out and `version.ae` leaves out: 1.0.0-rc.1 sorts *before* 1.0.0, and
// build metadata never participates. Prerelease identifiers are modelled as an
// ordinal rather than a string list: `pre` is 0 for a release (which is the
// greatest value) and a positive identifier position otherwise.

pub struct SemVerOrder {
    major: i64,
    minor: i64,
    patch: i64,
    pre: i64,
}

pub fn semver_order(major: i64, minor: i64, patch: i64, pre: i64) -> SemVerOrder {
    return SemVerOrder { major: major, minor: minor, patch: patch, pre: pre };
}

pub fn semver_release(major: i64, minor: i64, patch: i64) -> SemVerOrder {
    return SemVerOrder { major: major, minor: minor, patch: patch, pre: 0 };
}

pub fn semver_is_prerelease(v: SemVerOrder) -> bool {
    // A negative ordinal is not a version at all; treat it as a prerelease so a
    // caller that built one by accident does not get release precedence.
    return v.pre != 0;
}

pub fn semver_cmp_fields(amajor: i64, aminor: i64, apatch: i64, apre: i64, bmajor: i64, bminor: i64, bpatch: i64, bpre: i64) -> i64 {
    // Field-level so a caller can compare without giving up its operands: a
    // struct passed to a function is moved, a field read is not.
    if amajor != bmajor {
        if amajor > bmajor {
            return 1;
        }
        return -1;
    }
    if aminor != bminor {
        if aminor > bminor {
            return 1;
        }
        return -1;
    }
    if apatch != bpatch {
        if apatch > bpatch {
            return 1;
        }
        return -1;
    }
    if apre == bpre {
        return 0;
    }
    // No prerelease outranks any prerelease of the same major.minor.patch.
    if apre == 0 {
        return 1;
    }
    if bpre == 0 {
        return -1;
    }
    if apre > bpre {
        return 1;
    }
    return -1;
}

pub fn semver_cmp(a: SemVerOrder, b: SemVerOrder) -> i64 {
    return semver_cmp_fields(a.major, a.minor, a.patch, a.pre, b.major, b.minor, b.patch, b.pre);
}

pub fn semver_gt(a: SemVerOrder, b: SemVerOrder) -> bool {
    return semver_cmp(a, b) > 0;
}

pub fn semver_lt(a: SemVerOrder, b: SemVerOrder) -> bool {
    return semver_cmp(a, b) < 0;
}

pub fn semver_same(a: SemVerOrder, b: SemVerOrder) -> bool {
    return semver_cmp(a, b) == 0;
}

pub fn semver_max(a: SemVerOrder, b: SemVerOrder) -> SemVerOrder {
    // Ties keep the first argument so the result never depends on call order in
    // a way a caller could observe.
    if semver_cmp_fields(a.major, a.minor, a.patch, a.pre, b.major, b.minor, b.patch, b.pre) >= 0 {
        return SemVerOrder { major: a.major, minor: a.minor, patch: a.patch, pre: a.pre };
    }
    return SemVerOrder { major: b.major, minor: b.minor, patch: b.patch, pre: b.pre };
}

pub fn semver_compatible_major(a: SemVerOrder, b: SemVerOrder) -> bool {
    // 1.x and 1.y are the same compatibility line; 0.x versions are explicitly
    // unstable, so two 0.x versions agree only when the whole prefix matches.
    if a.major != b.major {
        return false;
    }
    if a.major > 0 {
        return true;
    }
    return a.minor == b.minor && a.patch == b.patch;
}
