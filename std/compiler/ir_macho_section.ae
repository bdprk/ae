// std/compiler/ir_macho_section.ae
// Compiler Mach-O section_64 descriptor and section attribute flags.

pub struct MachOSection64 {
    sectname_id: i64,
    segname_id: i64,
    addr: i64,
    size: i64,
    align_pow2: i64,
    flags: i64, // 0x80000000=S_ATTR_SOME_INSTRUCTIONS, 0x00000400=S_ATTR_PURE_INSTRUCTIONS
}

pub fn macho_section_new(sname: i64, segname: i64, addr: i64, sz: i64, align: i64, flags: i64) -> MachOSection64 {
    return MachOSection64 {
        sectname_id: sname,
        segname_id: segname,
        addr: addr,
        size: sz,
        align_pow2: align,
        flags: flags,
    };
}

pub fn macho_section_is_code(s: MachOSection64) -> bool {
    // Check if code attributes set
    return s.flags > 0;
}

pub fn macho_section_size(s: MachOSection64) -> i64 {
    return s.size;
}
