// std/compiler/ir_thread_local.ae
// Compiler Thread Local Storage (TLS) model and GD/LD/IE/LE relocation descriptor.

pub struct TlsDescriptor {
    symbol_id: i64,
    tls_model: i64,      // 1=GeneralDynamic, 2=LocalDynamic, 3=InitialExec, 4=LocalExec
    offset_in_tcb: i64,  // Offset relative to thread control block (FS/GS register)
}

pub fn tls_descriptor_new(sym: i64, model: i64, offset: i64) -> TlsDescriptor {
    return TlsDescriptor {
        symbol_id: sym,
        tls_model: model,
        offset_in_tcb: offset,
    };
}

pub fn tls_is_local_exec(d: TlsDescriptor) -> bool {
    return d.tls_model == 4;
}

pub fn tls_is_initial_exec(d: TlsDescriptor) -> bool {
    return d.tls_model == 3;
}

pub fn tls_offset(d: TlsDescriptor) -> i64 {
    return d.offset_in_tcb;
}
