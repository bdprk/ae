// std/compiler/ir_strength_reduce.ae
// Compiler strength reduction candidate matcher (e.g. multiply by power of two into shift).

pub struct StrengthReduceCandidate {
    opcode: i64,      // 1 = MUL, 2 = DIV, 3 = MOD
    const_operand: i64,
}

pub fn strength_reduce_new(op: i64, operand: i64) -> StrengthReduceCandidate {
    return StrengthReduceCandidate {
        opcode: op,
        const_operand: operand,
    };
}

pub fn strength_reduce_is_power_of_two(val: i64) -> bool {
    if val <= 0 {
        return false;
    }
    // Check if exactly 1 bit is set
    var v = val;
    while (v % 2) == 0 {
        v = v / 2;
    }
    return v == 1;
}

pub fn strength_reduce_log2(val: i64) -> i64 {
    var v = val;
    var shift = 0;
    while v > 1 {
        v = v / 2;
        shift = shift + 1;
    }
    return shift;
}

pub fn strength_reduce_can_shift(c: StrengthReduceCandidate) -> bool {
    // Only MUL or DIV by positive power of two
    if c.opcode != 1 && c.opcode != 2 {
        return false;
    }
    return strength_reduce_is_power_of_two(c.const_operand);
}
