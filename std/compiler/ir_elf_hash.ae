// std/compiler/ir_elf_hash.ae
// Compiler ELF symbol hash (SysV and GNU) table bucket index calculator.

pub fn elf_sysv_hash_byte(prev_hash: i64, ch: i64) -> i64 {
    // h = (h << 4) + ch; g = h & 0xf0000000; if g != 0 { h ^= g >> 24; }; h &= ~g
    let h1 = prev_hash * 16 + ch;
    // Modulo 2^32 simulation
    let h32 = h1 % 4294967296;
    return h32;
}

pub fn elf_gnu_hash_byte(prev_hash: i64, ch: i64) -> i64 {
    // h = (h << 5) + h + ch = h * 33 + ch
    let h1 = prev_hash * 33 + ch;
    let h32 = h1 % 4294967296;
    return h32;
}

pub fn elf_hash_bucket(hash: i64, num_buckets: i64) -> i64 {
    if num_buckets <= 0 {
        return 0;
    }
    return hash % num_buckets;
}
