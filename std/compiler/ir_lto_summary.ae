// std/compiler/ir_lto_summary.ae
// Link-Time Optimization (LTO) cross-module call graph summary structures.
// Records function summary records: hotness, instruction count estimate,
// external reference count, and call site cross-module edges.

pub struct FuncLtoSummary {
    func_id: i64,
    inst_count: i64,
    call_edges_count: i64,
    is_externally_visible: bool,
    hotness_score: i64, // 0: cold, 1: normal, 2: hot, 3: critical
}

pub struct LtoCallEdge {
    caller_id: i64,
    callee_id: i64,
    call_count_estimate: i64,
    is_direct: bool,
}

pub fn make_func_lto_summary(func_id: i64, inst_count: i64, calls: i64, visible: bool) -> FuncLtoSummary {
    return FuncLtoSummary {
        func_id: func_id,
        inst_count: inst_count,
        call_edges_count: calls,
        is_externally_visible: visible,
        hotness_score: 1,
    };
}

pub fn lto_should_import(summary: FuncLtoSummary, threshold_insts: i64) -> bool {
    // Import functions that are small enough or not hot-restricted
    return summary.inst_count <= threshold_insts;
}

pub fn make_lto_call_edge(caller: i64, callee: i64, direct: bool) -> LtoCallEdge {
    return LtoCallEdge {
        caller_id: caller,
        callee_id: callee,
        call_count_estimate: 1,
        is_direct: direct,
    };
}
