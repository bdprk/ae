// std/compiler/ir_wasm_global.ae
// Compiler WebAssembly global variable descriptor (valtype, mutability flag, and init value).

pub struct WasmGlobal {
    val_type: i64,      // 0x7E = i64, 0x7F = i32
    is_mutable: bool,
    init_const: i64,
}

pub fn wasm_global_new(vtype: i64, mutable: bool, init_val: i64) -> WasmGlobal {
    return WasmGlobal {
        val_type: vtype,
        is_mutable: mutable,
        init_const: init_val,
    };
}

pub fn wasm_global_is_mutable(g: WasmGlobal) -> bool {
    return g.is_mutable;
}

pub fn wasm_global_init(g: WasmGlobal) -> i64 {
    return g.init_const;
}

pub fn wasm_global_type(g: WasmGlobal) -> i64 {
    return g.val_type;
}
