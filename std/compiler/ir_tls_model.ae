// std/compiler/ir_tls_model.ae
// Compiler Thread Local Storage (TLS) access sequence lowering and access pattern selector.

pub struct TlsAccessPattern {
    tls_model: i64,      // 1=GD, 2=LD, 3=IE, 4=LE
    is_shared_library: bool,
    is_local_symbol: bool,
}

pub fn tls_pattern_new(model: i64, shared: bool, local_sym: bool) -> TlsAccessPattern {
    return TlsAccessPattern {
        tls_model: model,
        is_shared_library: shared,
        is_local_symbol: local_sym,
    };
}

pub fn tls_can_relax_to_local_exec(p: TlsAccessPattern) -> bool {
    // If not building shared library and symbol is locally bound, GD/IE can relax to LE
    return !p.is_shared_library && p.is_local_symbol;
}

pub fn tls_requires_dynamic_lookup(p: TlsAccessPattern) -> bool {
    // GD or LD in shared library requires __tls_get_addr call
    return p.is_shared_library && (p.tls_model == 1 || p.tls_model == 2);
}
