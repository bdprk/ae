// std/compiler/ir_wasm_call_indirect.ae
// Compiler WebAssembly call_indirect operand validator and signature index mapper.

pub struct WasmCallIndirect {
    type_index: i64,
    table_index: i64,
}

pub fn wasm_call_indirect_new(type_idx: i64, table_idx: i64) -> WasmCallIndirect {
    return WasmCallIndirect {
        type_index: type_idx,
        table_index: table_idx,
    };
}

pub fn wasm_call_indirect_type(c: WasmCallIndirect) -> i64 {
    return c.type_index;
}

pub fn wasm_call_indirect_table(c: WasmCallIndirect) -> i64 {
    return c.table_index;
}
