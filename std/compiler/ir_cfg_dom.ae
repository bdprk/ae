// std/compiler/ir_cfg_dom.ae
// Compiler dominator tree immediate dominator (idom) and dominance frontier primitives.

pub struct DomTreeNode {
    block_id: i64,
    idom_id: i64,
    dom_depth: i64,
}

pub fn dom_node_new(block: i64, idom: i64, depth: i64) -> DomTreeNode {
    return DomTreeNode {
        block_id: block,
        idom_id: idom,
        dom_depth: depth,
    };
}

pub fn dom_is_root(n: DomTreeNode) -> bool {
    return n.idom_id == n.block_id;
}

pub fn dom_depth(n: DomTreeNode) -> i64 {
    return n.dom_depth;
}

pub fn dom_idom(n: DomTreeNode) -> i64 {
    return n.idom_id;
}
