// std/compiler/ir_opcode.ae
// Compiler Intermediate Representation (IR) bytecode opcode primitives.

pub enum IrOpcode {
    OpNop,
    OpConstInt(i64),
    OpConstBool(bool),
    OpLoadLocal(i64),
    OpStoreLocal(i64),
    OpAdd,
    OpSub,
    OpMul,
    OpDiv,
    OpEqual,
    OpJump(i64),
    OpJumpIfFalse(i64),
    OpCall(i64),
    OpReturn,
}

pub fn ir_opcode_is_jump(op: IrOpcode) -> bool {
    var r = false;
    match op {
        IrOpcode::OpNop => {}
        IrOpcode::OpConstInt(v) => {}
        IrOpcode::OpConstBool(b) => {}
        IrOpcode::OpLoadLocal(idx) => {}
        IrOpcode::OpStoreLocal(idx) => {}
        IrOpcode::OpAdd => {}
        IrOpcode::OpSub => {}
        IrOpcode::OpMul => {}
        IrOpcode::OpDiv => {}
        IrOpcode::OpEqual => {}
        IrOpcode::OpJump(target) => { r = true; }
        IrOpcode::OpJumpIfFalse(target) => { r = true; }
        IrOpcode::OpCall(id) => {}
        IrOpcode::OpReturn => {}
    }
    return r;
}

pub fn ir_opcode_is_terminator(op: IrOpcode) -> bool {
    var r = false;
    match op {
        IrOpcode::OpNop => {}
        IrOpcode::OpConstInt(v) => {}
        IrOpcode::OpConstBool(b) => {}
        IrOpcode::OpLoadLocal(idx) => {}
        IrOpcode::OpStoreLocal(idx) => {}
        IrOpcode::OpAdd => {}
        IrOpcode::OpSub => {}
        IrOpcode::OpMul => {}
        IrOpcode::OpDiv => {}
        IrOpcode::OpEqual => {}
        IrOpcode::OpJump(target) => { r = true; }
        IrOpcode::OpJumpIfFalse(target) => {}
        IrOpcode::OpCall(id) => {}
        IrOpcode::OpReturn => { r = true; }
    }
    return r;
}
