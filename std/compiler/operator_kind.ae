// std/compiler/operator_kind.ae
// Compiler operator token precedence and classification primitives.

pub enum OperatorPrecedence {
    Lowest,
    Assignment,
    LogicalOr,
    LogicalAnd,
    Comparison,
    Bitwise,
    Additive,
    Multiplicative,
    Unary,
    Highest,
}

pub fn operator_precedence_rank(p: OperatorPrecedence) -> i64 {
    var rank = 0;
    match p {
        OperatorPrecedence::Lowest => { rank = 0; }
        OperatorPrecedence::Assignment => { rank = 1; }
        OperatorPrecedence::LogicalOr => { rank = 2; }
        OperatorPrecedence::LogicalAnd => { rank = 3; }
        OperatorPrecedence::Comparison => { rank = 4; }
        OperatorPrecedence::Bitwise => { rank = 5; }
        OperatorPrecedence::Additive => { rank = 6; }
        OperatorPrecedence::Multiplicative => { rank = 7; }
        OperatorPrecedence::Unary => { rank = 8; }
        OperatorPrecedence::Highest => { rank = 9; }
    }
    return rank;
}

pub fn operator_is_higher(a: OperatorPrecedence, b: OperatorPrecedence) -> bool {
    return operator_precedence_rank(a) > operator_precedence_rank(b);
}
