// std/compiler/ir_lsda.ae
// Language Specific Data Area arithmetic: the four tables an unwind table
// entry points at when a frame has cleanups or catch clauses. The layout is
// fixed by the Itanium C++ ABI: LPStart, TType, the call-site table, the type
// table, and the action table. Only sizes and the cleanup/ catch distinction
// are modelled; no section is emitted.

use "ir_eh_pe.ae";

pub fn lsda_call_site_entry_bytes(call_site_encoding: i64) -> i64 {
    // Four fields per entry: start, length, landing pad, action.
    let field = eh_pe_field_bytes(call_site_encoding);
    if field == 0 {
        return 0;
    }
    return 4 * field;
}

pub fn lsda_call_site_table_bytes(count: i64, call_site_encoding: i64) -> i64 {
    if count <= 0 {
        return 0;
    }
    return count * lsda_call_site_entry_bytes(call_site_encoding);
}

pub fn lsda_type_table_bytes(count: i64, ttype_encoding: i64) -> i64 {
    if count <= 0 {
        return 0;
    }
    let field = eh_pe_field_bytes(ttype_encoding);
    if field == 0 {
        return 0;
    }
    return count * field;
}

pub fn lsda_type_table_index(type_slot: i64, ttype_encoding: i64) -> i64 {
    // Type slots are one-based in the action table; zero means "no type".
    if type_slot <= 0 {
        return 0;
    }
    let field = eh_pe_field_bytes(ttype_encoding);
    if field == 0 {
        return 0;
    }
    return (type_slot - 1) * field;
}

pub fn lsda_sleb_bytes(value: i64) -> i64 {
    // Minimal signed LEB128 width: n bytes carry 7n bits plus a sign.
    if value >= -64 && value <= 63 {
        return 1;
    }
    if value >= -8192 && value <= 8191 {
        return 2;
    }
    if value >= -1048576 && value <= 1048575 {
        return 3;
    }
    if value >= -134217728 && value <= 134217727 {
        return 4;
    }
    return 5;
}

pub fn lsda_action_record_bytes(type_filter: i64, next_offset: i64) -> i64 {
    // One action record is a signed LEB128 type filter followed by a signed
    // LEB128 byte distance to the next record of this chain.
    return lsda_sleb_bytes(type_filter) + lsda_sleb_bytes(next_offset);
}

pub fn lsda_cleanup_action() -> i64 {
    return 0;
}

pub fn lsda_action_is_cleanup(action: i64) -> bool {
    // Action zero means "run destructors only": no type filter follows.
    return action == 0;
}

pub fn lsda_action_record_offset(action: i64, action_table_bytes: i64) -> i64 {
    // A non-zero action is the negative byte distance from the call-site entry
    // back to its action record, relative to the end of the action table.
    if action <= 0 || action_table_bytes <= 0 {
        return 0;
    }
    let offset = action_table_bytes - action;
    if offset < 0 {
        return 0;
    }
    return offset;
}

pub fn lsda_section_bytes(header: i64, call_site_table: i64, type_table: i64, action_table: i64) -> i64 {
    if header < 0 || call_site_table < 0 || type_table < 0 || action_table < 0 {
        return -1;
    }
    return header + call_site_table + type_table + action_table;
}
