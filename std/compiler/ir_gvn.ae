// std/compiler/ir_gvn.ae
// Compiler Global Value Numbering (GVN) expression equivalence key and canonical lookup.

pub struct GvnKey {
    opcode: i64,
    left_vreg: i64,
    right_vreg: i64,
}

pub fn gvn_key_new(op: i64, lhs: i64, rhs: i64) -> GvnKey {
    // If commutative operation (e.g. 1=ADD, 2=MUL, 3=BITAND, 4=BITOR, 5=BITXOR), normalize lhs <= rhs
    var l = lhs;
    var r = rhs;
    if (op >= 1 && op <= 5) && l > r {
        let tmp = l;
        l = r;
        r = tmp;
    }
    return GvnKey {
        opcode: op,
        left_vreg: l,
        right_vreg: r,
    };
}

pub fn gvn_key_opcode(k: GvnKey) -> i64 {
    return k.opcode;
}

pub fn gvn_key_lhs(k: GvnKey) -> i64 {
    return k.left_vreg;
}

pub fn gvn_key_rhs(k: GvnKey) -> i64 {
    return k.right_vreg;
}

pub fn gvn_keys_equal(k1: GvnKey, k2: GvnKey) -> bool {
    return k1.opcode == k2.opcode && k1.left_vreg == k2.left_vreg && k1.right_vreg == k2.right_vreg;
}
