// std/compiler/ir_cfg_loop.ae
// Compiler natural loop identification and loop header/preheader/latch descriptor.

pub struct NaturalLoop {
    header_block: i64,
    latch_block: i64,
    preheader_block: i64,
    is_reducible: bool,
}

pub fn natural_loop_new(header: i64, latch: i64, preheader: i64, reducible: bool) -> NaturalLoop {
    return NaturalLoop {
        header_block: header,
        latch_block: latch,
        preheader_block: preheader,
        is_reducible: reducible,
    };
}

pub fn loop_is_reducible(l: NaturalLoop) -> bool {
    return l.is_reducible;
}

pub fn loop_header(l: NaturalLoop) -> i64 {
    return l.header_block;
}

pub fn loop_latch(l: NaturalLoop) -> i64 {
    return l.latch_block;
}

pub fn loop_preheader(l: NaturalLoop) -> i64 {
    return l.preheader_block;
}
