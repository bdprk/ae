// std/compiler/ir_lockfile.ae
// Lock entry state: the resolved version a lock file records for a package,
// where it came from, and whether the recorded checksum still matches the
// fetched content. A lock that disagrees with the resolution, or whose checksum
// no longer verifies, must be rewritten rather than trusted.

use "ir_mvs.ae";

pub fn lock_source_registry() -> i64 {
    return 1;
}

pub fn lock_source_git() -> i64 {
    return 2;
}

pub fn lock_source_path() -> i64 {
    return 3;
}

pub fn lock_source_is_known(source: i64) -> bool {
    return source >= lock_source_registry() && source <= lock_source_path();
}

pub struct LockEntry {
    pkg: i64,
    major: i64,
    minor: i64,
    patch: i64,
    source: i64,
    checksum_verified: bool,
}

pub fn lock_entry(pkg: i64, major: i64, minor: i64, patch: i64, source: i64, checksum_verified: bool) -> LockEntry {
    return LockEntry {
        pkg: pkg,
        major: major,
        minor: minor,
        patch: patch,
        source: source,
        checksum_verified: checksum_verified,
    };
}

pub fn lock_entry_matches_pick(entry: LockEntry, pkg: i64, major: i64, minor: i64, patch: i64) -> bool {
    if entry.pkg != pkg {
        return false;
    }
    return semver_same(
        semver_release(entry.major, entry.minor, entry.patch),
        semver_release(major, minor, patch));
}

pub fn lock_entry_needs_update(entry: LockEntry, pkg: i64, major: i64, minor: i64, patch: i64) -> bool {
    return !lock_entry_matches_pick(entry, pkg, major, minor, patch);
}

pub fn lock_entry_is_trusted(entry: LockEntry) -> bool {
    // A path dependency has no content hash to verify, so only its source needs
    // to be known; every other source must have passed the checksum.
    if !lock_source_is_known(entry.source) {
        return false;
    }
    if entry.source == lock_source_path() {
        return true;
    }
    return entry.checksum_verified;
}

pub fn lock_entry_requires_checksum(entry: LockEntry) -> bool {
    return entry.source != lock_source_path();
}

pub fn lock_entry_same_package(a: LockEntry, b: LockEntry) -> bool {
    return a.pkg == b.pkg && a.source == b.source;
}

pub fn lockfile_needs_rewrite(entry: LockEntry, pkg: i64, major: i64, minor: i64, patch: i64) -> bool {
    // Rewrite when the entry no longer describes the resolution, or when it
    // cannot be trusted as it stands. The fields are copied out first because
    // each check consumes the entry it is given.
    let ep = entry.pkg;
    let em = entry.major;
    let en = entry.minor;
    let epa = entry.patch;
    let es = entry.source;
    let ec = entry.checksum_verified;
    if lock_entry_needs_update(lock_entry(ep, em, en, epa, es, ec), pkg, major, minor, patch) {
        return true;
    }
    return !lock_entry_is_trusted(lock_entry(ep, em, en, epa, es, ec));
}
