// std/compiler/ir_pe_data_dir.ae
// Compiler Windows PE data directory entry and virtual address bound validator.

pub struct PeDataDirectory {
    virtual_address: i64,
    size_bytes: i64,
}

pub fn pe_data_dir_new(v_addr: i64, sz: i64) -> PeDataDirectory {
    return PeDataDirectory {
        virtual_address: v_addr,
        size_bytes: sz,
    };
}

pub fn pe_data_dir_is_present(d: PeDataDirectory) -> bool {
    return d.virtual_address > 0 && d.size_bytes > 0;
}

pub fn pe_data_dir_end_addr(d: PeDataDirectory) -> i64 {
    return d.virtual_address + d.size_bytes;
}
