// std/compiler/ir_def_exports.ae
// Windows Module-Definition (.def) file export parsing and representation.
// Models EXPORTS directives: symbol name, ordinal number, NONAME flag,
// CONSTANT/DATA flag, and forwarded export target strings.

pub struct DefExportEntry {
    symbol_id: i64,
    ordinal: i64,
    is_noname: bool,
    is_data: bool,
    forward_id: i64, // 0 if not forwarded, else string id of forwarded target
}

pub fn make_def_export(sym_id: i64, ordinal: i64) -> DefExportEntry {
    return DefExportEntry {
        symbol_id: sym_id,
        ordinal: ordinal,
        is_noname: false,
        is_data: false,
        forward_id: 0,
    };
}

pub fn def_export_with_flags(sym_id: i64, ordinal: i64, noname: bool, data: bool) -> DefExportEntry {
    return DefExportEntry {
        symbol_id: sym_id,
        ordinal: ordinal,
        is_noname: noname,
        is_data: data,
        forward_id: 0,
    };
}

pub fn def_is_forwarded(entry: DefExportEntry) -> bool {
    return entry.forward_id != 0;
}

pub fn def_has_explicit_ordinal(entry: DefExportEntry) -> bool {
    return entry.ordinal > 0;
}
