// std/compiler/ir_call_graph.ae
// Compiler call graph edge representation and recursive cycle detection state.

pub struct CallGraphEdge {
    caller_id: i64,
    callee_id: i64,
    call_count: i64,
    is_direct: bool,
}

pub fn call_graph_edge_new(caller: i64, callee: i64, count: i64, direct: bool) -> CallGraphEdge {
    return CallGraphEdge {
        caller_id: caller,
        callee_id: callee,
        call_count: count,
        is_direct: direct,
    };
}

pub fn call_graph_is_recursive(edge: CallGraphEdge) -> bool {
    // Direct self-recursion
    return edge.caller_id == edge.callee_id;
}

pub fn call_graph_is_hot(edge: CallGraphEdge, threshold: i64) -> bool {
    return edge.call_count >= threshold;
}
