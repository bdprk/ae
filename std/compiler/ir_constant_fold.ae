// std/compiler/ir_constant_fold.ae
// Compiler constant folding optimization primitives.

pub struct FoldResult {
    folded: bool,
    value: i64,
}

pub fn fold_result_folded(val: i64) -> FoldResult {
    return FoldResult {
        folded: true,
        value: val,
    };
}

pub fn fold_result_none() -> FoldResult {
    return FoldResult {
        folded: false,
        value: 0,
    };
}

pub fn fold_result_is_folded(r: FoldResult) -> bool {
    return r.folded;
}

pub fn fold_result_val(r: FoldResult) -> i64 {
    return r.value;
}

pub fn fold_add_i64(a: i64, b: i64) -> FoldResult {
    return FoldResult {
        folded: true,
        value: a + b,
    };
}

pub fn fold_sub_i64(a: i64, b: i64) -> FoldResult {
    return FoldResult {
        folded: true,
        value: a - b,
    };
}

pub fn fold_mul_i64(a: i64, b: i64) -> FoldResult {
    return FoldResult {
        folded: true,
        value: a * b,
    };
}

pub fn fold_div_i64(a: i64, b: i64) -> FoldResult {
    if b == 0 {
        return FoldResult {
            folded: false,
            value: 0,
        };
    }
    return FoldResult {
        folded: true,
        value: a / b,
    };
}
