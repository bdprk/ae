// std/compiler/ir_live_range.ae
// Compiler register live range interval primitives for linear scan register allocators.

pub struct LiveRange {
    vreg_id: i64,
    start_point: i64,
    end_point: i64,
}

pub fn live_range_new(reg: i64, start: i64, end: i64) -> LiveRange {
    var s = start;
    var e = end;
    if s > e {
        let tmp = s;
        s = e;
        e = tmp;
    }
    return LiveRange {
        vreg_id: reg,
        start_point: s,
        end_point: e,
    };
}

pub fn live_range_reg(lr: LiveRange) -> i64 {
    return lr.vreg_id;
}

pub fn live_range_start(lr: LiveRange) -> i64 {
    return lr.start_point;
}

pub fn live_range_end(lr: LiveRange) -> i64 {
    return lr.end_point;
}

pub fn live_range_covers(lr: LiveRange, point: i64) -> bool {
    return point >= lr.start_point && point <= lr.end_point;
}

pub fn live_range_interferes(a: LiveRange, b: LiveRange) -> bool {
    return a.start_point <= b.end_point && b.start_point <= a.end_point;
}
