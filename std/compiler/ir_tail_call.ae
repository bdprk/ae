// std/compiler/ir_tail_call.ae
// Compiler tail call optimization (TCO) and sibling call eligibility checker.

pub struct TailCallEligibility {
    is_in_return_position: bool,
    caller_ret_matches_callee_ret: bool,
    frame_cleanup_is_trivial: bool,
}

pub fn tail_call_new(ret_pos: bool, ret_match: bool, cleanup_trivial: bool) -> TailCallEligibility {
    return TailCallEligibility {
        is_in_return_position: ret_pos,
        caller_ret_matches_callee_ret: ret_match,
        frame_cleanup_is_trivial: cleanup_trivial,
    };
}

pub fn tail_call_can_optimize(t: TailCallEligibility) -> bool {
    return t.is_in_return_position && t.caller_ret_matches_callee_ret && t.frame_cleanup_is_trivial;
}
