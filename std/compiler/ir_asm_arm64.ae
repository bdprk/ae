// std/compiler/ir_asm_arm64.ae
// Compiler ARM64 AArch64 register naming and link/frame register conventions.

pub fn asm_arm64_is_link_register(reg_idx: i64) -> bool {
    // X30 (LR)
    return reg_idx == 30;
}

pub fn asm_arm64_is_frame_pointer(reg_idx: i64) -> bool {
    // X29 (FP)
    return reg_idx == 29;
}

pub fn asm_arm64_is_callee_saved(reg_idx: i64) -> bool {
    // X19 to X28, plus X29 (FP)
    return (reg_idx >= 19 && reg_idx <= 28) || reg_idx == 29;
}

pub fn asm_arm64_is_param_reg(reg_idx: i64) -> bool {
    // X0 to X7
    return reg_idx >= 0 && reg_idx <= 7;
}
