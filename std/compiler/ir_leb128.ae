// std/compiler/ir_leb128.ae
// Zero-allocation unsigned LEB128 encoding length and byte extraction primitives for DWARF/Wasm.

pub fn uleb128_encoded_len(val: i64) -> i64 {
    if val < 0 {
        return 10;
    }
    if val < 128 {
        return 1;
    }
    if val < 16384 {
        return 2;
    }
    if val < 2097152 {
        return 3;
    }
    if val < 268435456 {
        return 4;
    }
    return 5;
}

pub fn uleb128_extract_byte(val: i64, byte_idx: i64) -> i64 {
    var v = val;
    var i = 0;
    while i < byte_idx {
        v = v / 128;
        i = i + 1;
    }
    let cur_byte = v % 128;
    let remaining = v / 128;
    if remaining > 0 {
        return cur_byte + 128; // set continuation bit 0x80
    }
    return cur_byte;
}
