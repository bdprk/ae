// std/compiler/ir_spill.ae
// Compiler register spill weight and heuristic calculator.

pub struct SpillCost {
    vreg_id: i64,
    use_count: i64,
    loop_depth: i64,
}

pub fn spill_cost_new(vreg: i64, uses: i64, depth: i64) -> SpillCost {
    return SpillCost {
        vreg_id: vreg,
        use_count: uses,
        loop_depth: depth,
    };
}

pub fn spill_cost_weight(sc: SpillCost) -> i64 {
    // Loop weight multiplier: 10^depth approximated safely as 1 + depth * 8
    let depth_factor = 1 + sc.loop_depth * 8;
    return sc.use_count * depth_factor;
}

pub fn spill_cost_should_spill(cost_a: i64, cost_b: i64) -> bool {
    // Spill candidate with lower cost
    return cost_a < cost_b;
}
