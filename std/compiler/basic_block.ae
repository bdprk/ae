// std/compiler/basic_block.ae
// Compiler Control Flow Graph (CFG) basic block tracking primitive.

pub struct BasicBlockHeader {
    block_id: i64,
    instruction_count: i64,
    has_terminator: bool,
}

pub fn basic_block_new(id: i64) -> BasicBlockHeader {
    return BasicBlockHeader {
        block_id: id,
        instruction_count: 0,
        has_terminator: false,
    };
}

pub fn basic_block_id(bb: BasicBlockHeader) -> i64 {
    return bb.block_id;
}

pub fn basic_block_instruction_count(bb: BasicBlockHeader) -> i64 {
    return bb.instruction_count;
}

pub fn basic_block_has_terminator(bb: BasicBlockHeader) -> bool {
    return bb.has_terminator;
}

pub fn basic_block_add_instruction(bb: BasicBlockHeader, is_terminator: bool) -> BasicBlockHeader {
    let cur_id = bb.block_id;
    let cur_count = bb.instruction_count;
    let cur_term = bb.has_terminator;

    if cur_term {
        return BasicBlockHeader {
            block_id: cur_id,
            instruction_count: cur_count,
            has_terminator: cur_term,
        };
    }
    return BasicBlockHeader {
        block_id: cur_id,
        instruction_count: cur_count + 1,
        has_terminator: is_terminator,
    };
}
