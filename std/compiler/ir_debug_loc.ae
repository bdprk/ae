// std/compiler/ir_debug_loc.ae
// Compiler source code location span and synthetic flag tracker.

pub struct DebugLoc {
    file_id: i64,
    line: i64,
    column: i64,
    is_synthetic: bool, // E.g., compiler-generated cleanup or runtime glue
}

pub fn debug_loc_new(file: i64, line: i64, col: i64, synthetic: bool) -> DebugLoc {
    return DebugLoc {
        file_id: file,
        line: line,
        column: col,
        is_synthetic: synthetic,
    };
}

pub fn debug_loc_is_synthetic(loc: DebugLoc) -> bool {
    return loc.is_synthetic;
}

pub fn debug_loc_same_point(loc1: DebugLoc, loc2: DebugLoc) -> bool {
    return loc1.file_id == loc2.file_id && loc1.line == loc2.line && loc1.column == loc2.column;
}
