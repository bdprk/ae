// std/compiler/ir_wasm_stack_frame.ae
// Compiler WebAssembly shadow stack frame layout for reference and heap spill.

pub struct WasmShadowStackFrame {
    total_spill_bytes: i64,
    alignment: i64,
}

pub fn wasm_frame_new(spill_bytes: i64, align: i64) -> WasmShadowStackFrame {
    return WasmShadowStackFrame {
        total_spill_bytes: spill_bytes,
        alignment: align,
    };
}

pub fn wasm_frame_aligned_size(f: WasmShadowStackFrame) -> i64 {
    let raw = f.total_spill_bytes;
    let align = f.alignment;
    let rem = raw % align;
    if rem > 0 {
        return raw + (align - rem);
    }
    return raw;
}
