// std/compiler/ir_cfg_critical.ae
// Compiler critical edge splitting candidate detector.

pub struct CfgCriticalEdge {
    src_block: i64,
    dst_block: i64,
    src_successor_count: i64,
    dst_predecessor_count: i64,
}

pub fn critical_edge_new(src: i64, dst: i64, succs: i64, preds: i64) -> CfgCriticalEdge {
    return CfgCriticalEdge {
        src_block: src,
        dst_block: dst,
        src_successor_count: succs,
        dst_predecessor_count: preds,
    };
}

pub fn critical_edge_is_critical(e: CfgCriticalEdge) -> bool {
    // Critical edge has source with > 1 successor AND destination with > 1 predecessor
    return e.src_successor_count > 1 && e.dst_predecessor_count > 1;
}

pub fn critical_edge_needs_split(e: CfgCriticalEdge) -> bool {
    return critical_edge_is_critical(e);
}
