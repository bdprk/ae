// std/compiler/ir_pe_coff_header.ae
// Compiler Windows PE/COFF file header and architecture machine validator.

pub struct CoffHeader {
    machine_arch: i64,   // 0x8664 = IMAGE_FILE_MACHINE_AMD64, 0xAA64 = IMAGE_FILE_MACHINE_ARM64
    number_of_sections: i64,
    pointer_to_symtab: i64,
    number_of_symbols: i64,
    characteristics: i64, // 0x0020 = IMAGE_FILE_LARGE_ADDRESS_AWARE
}

pub fn coff_header_new(machine: i64, sects: i64, sym_ptr: i64, num_syms: i64, chars: i64) -> CoffHeader {
    return CoffHeader {
        machine_arch: machine,
        number_of_sections: sects,
        pointer_to_symtab: sym_ptr,
        number_of_symbols: num_syms,
        characteristics: chars,
    };
}

pub fn coff_is_x64(h: CoffHeader) -> bool {
    // 0x8664 = 34404
    return h.machine_arch == 34404;
}

pub fn coff_is_arm64(h: CoffHeader) -> bool {
    // 0xAA64 = 43620
    return h.machine_arch == 43620;
}

pub fn coff_has_symbols(h: CoffHeader) -> bool {
    return h.number_of_symbols > 0 && h.pointer_to_symtab > 0;
}
