// std/compiler/ir_dwarf_expr.ae
// Compiler DWARF expression stack operations and opcode builder.

pub struct DwarfExprOp {
    opcode: i64, // 0x11=DW_OP_consts, 0x12=DW_OP_dup, 0x13=DW_OP_drop, 0x91=DW_OP_fbreg, 0x70=DW_OP_breg0
    operand1: i64,
}

pub fn dwarf_expr_new(op: i64, op1: i64) -> DwarfExprOp {
    return DwarfExprOp {
        opcode: op,
        operand1: op1,
    };
}

pub fn dwarf_expr_opcode(op: DwarfExprOp) -> i64 {
    return op.opcode;
}

pub fn dwarf_expr_operand(op: DwarfExprOp) -> i64 {
    return op.operand1;
}

pub fn dwarf_expr_is_fbreg(op: DwarfExprOp) -> bool {
    // 0x91 = DW_OP_fbreg (frame base relative offset)
    return op.opcode == 145;
}
