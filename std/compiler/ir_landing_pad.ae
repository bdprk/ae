// std/compiler/ir_landing_pad.ae
// Compiler exception handling and panic unwinding landing pad descriptor.

pub struct LandingPad {
    action_table_offset: i64,
    type_filter_id: i64,
    has_cleanup: bool,
}

pub fn landing_pad_new(action_offset: i64, filter_id: i64, cleanup: bool) -> LandingPad {
    return LandingPad {
        action_table_offset: action_offset,
        type_filter_id: filter_id,
        has_cleanup: cleanup,
    };
}

pub fn landing_pad_has_catch(lp: LandingPad) -> bool {
    return lp.type_filter_id > 0;
}

pub fn landing_pad_has_cleanup(lp: LandingPad) -> bool {
    return lp.has_cleanup;
}

pub fn landing_pad_action_offset(lp: LandingPad) -> i64 {
    return lp.action_table_offset;
}
